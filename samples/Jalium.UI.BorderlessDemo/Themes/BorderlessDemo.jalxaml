<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Jalium.UI.BorderlessDemo"
                    x:Class="Jalium.UI.BorderlessDemo.Themes.BorderlessDemoTheme">
    <Style x:Key="BorderlessDemo.Window" TargetType="Window">
        <Setter Property="Background" Value="#C8181825" />
    </Style>
    <Style x:Key="BorderlessDemo.Action" TargetType="Button">
        <Setter Property="Background" Value="#585B70" />
        <Setter Property="BorderBrush" Value="#6C7086" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="local:BorderlessDemoSurface">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="32" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:BorderlessDemoSurface">
            <Grid>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="WindowStates"><VisualState x:Name="Windowed" /><VisualState x:Name="Maximized" /><VisualState x:Name="FullScreen" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}" Height="44" Background="#11111B" Foreground="#CDD6F4" IsShowIcon="False" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="{TemplateBinding Padding}">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Description}" FontSize="22" Foreground="{TemplateBinding Foreground}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" Focusable="False" />
                        <TextBlock Text="{TemplateBinding Hint}" FontSize="12" Foreground="#A6ADC8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" Focusable="False" />
                        <TextBlock Text="{TemplateBinding StatusText}" FontSize="14" Foreground="#CDD6F4" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" Focusable="False" />
                        <Button x:Name="PART_EnterFullScreen" Style="{StaticResource BorderlessDemo.Action}" Content="进入全屏 (F11)" />
                        <Button x:Name="PART_ExitFullScreen" Style="{StaticResource BorderlessDemo.Action}" Content="退出全屏" />
                        <Button x:Name="PART_ToggleWindowStyle" Style="{StaticResource BorderlessDemo.Action}"><TextBlock Text="切换 WindowStyle (None ↔ SingleBorderWindow)" TextWrapping="Wrap" TextAlignment="Center" Focusable="False" /></Button>
                        <Button x:Name="PART_ToggleMaximize" Style="{StaticResource BorderlessDemo.Action}" Content="最大化 / 还原" />
                        <Button x:Name="PART_Close" Style="{StaticResource BorderlessDemo.Action}" Content="关闭窗口" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
