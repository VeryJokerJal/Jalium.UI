                    <Path x:Name="PART_Triangle" Canvas.Left="840" Canvas.Top="205" Stroke="#C8FF78" StrokeThickness="12" StrokeLineJoin="Miter" Data="M 60,0 L 120,100 L 0,100 Z" />
                    <Path x:Name="PART_LinearPad" Canvas.Left="30" Canvas.Top="380" ><Path.Data><RectangleGeometry Rect="0,0,130,120" /></Path.Data><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Pad"><GradientStop Color="#FF5078" Offset="0" /><GradientStop Color="#5078FF" Offset="1" /></LinearGradientBrush></Path.Fill></Path>
                    <Path x:Name="PART_LinearRepeat" Canvas.Left="190" Canvas.Top="380" ><Path.Data><RectangleGeometry Rect="0,0,130,120" /></Path.Data><Path.Fill><LinearGradientBrush StartPoint="0.3,0" EndPoint="0.45,0" SpreadMethod="Repeat"><GradientStop Color="#FF5078" Offset="0" /><GradientStop Color="#5078FF" Offset="1" /></LinearGradientBrush></Path.Fill></Path>
                    <Path x:Name="PART_LinearReflect" Canvas.Left="350" Canvas.Top="380" ><Path.Data><RectangleGeometry Rect="0,0,130,120" /></Path.Data><Path.Fill><LinearGradientBrush StartPoint="0.35,0" EndPoint="0.55,0" SpreadMethod="Reflect"><GradientStop Color="#FF5078" Offset="0" /><GradientStop Color="#5078FF" Offset="1" /></LinearGradientBrush></Path.Fill></Path>
                    <Path x:Name="PART_Radial" Canvas.Left="510" Canvas.Top="380" ><Path.Data><EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60" /></Path.Data><Path.Fill><RadialGradientBrush ><GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#1E78FF" Offset="0.7" /><GradientStop Color="#0A145A" Offset="1" /></RadialGradientBrush></Path.Fill></Path>
                    <Path x:Name="PART_Focal" Canvas.Left="660" Canvas.Top="380" ><Path.Data><EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60" /></Path.Data><Path.Fill><RadialGradientBrush GradientOrigin="0.30,0.30"><GradientStop Color="#FFFAC8" Offset="0" /><GradientStop Color="#FF8228" Offset="0.6" /><GradientStop Color="#781E0A" Offset="1" /></RadialGradientBrush></Path.Fill></Path>
                    <Path x:Name="PART_RadialReflect" Canvas.Left="810" Canvas.Top="380" ><Path.Data><EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60" /></Path.Data><Path.Fill><RadialGradientBrush RadiusX="0.18" RadiusY="0.18" SpreadMethod="Reflect"><GradientStop Color="#14DCB4" Offset="0" /><GradientStop Color="#0A283C" Offset="1" /></RadialGradientBrush></Path.Fill></Path>
