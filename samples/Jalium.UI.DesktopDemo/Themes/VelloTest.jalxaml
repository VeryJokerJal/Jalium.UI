                    <Path x:Name="PART_Miter" Canvas.Left="30" Canvas.Top="210" Stroke="#FF78A0" StrokeThickness="10" StrokeLineJoin="Miter" Data="M 0,60 L 30,10 L 60,60 L 90,10 L 120,60" />
                    <Path x:Name="PART_Round" Canvas.Left="190" Canvas.Top="210" Stroke="#78FFC8" StrokeThickness="10" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0,60 L 30,10 L 60,60 L 90,10 L 120,60" />
                    <Path x:Name="PART_Bevel" Canvas.Left="350" Canvas.Top="210" Stroke="#FFDC78" StrokeThickness="10" StrokeLineJoin="Bevel" StrokeStartLineCap="Square" StrokeEndLineCap="Square" Data="M 0,60 L 30,10 L 60,60 L 90,10 L 120,60" />
                    <Path x:Name="PART_Curve" Canvas.Left="510" Canvas.Top="210" Stroke="#8CB4FF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 5,70 C 45,-20 75,140 115,30" />
