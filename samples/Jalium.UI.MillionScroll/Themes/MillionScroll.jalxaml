<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Jalium.UI.MillionScroll"
                    x:Class="Jalium.UI.MillionScroll.Themes.MillionScrollTheme">
    <Style x:Key="MillionScroll.Window" TargetType="Window"><Setter Property="Background" Value="#121618" /></Style>
    <Style x:Key="MillionScroll.Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#89958F" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Focusable" Value="False" /></Style>
    <Style x:Key="MillionScroll.Action" TargetType="Button"><Setter Property="Background" Value="#223331" /><Setter Property="BorderBrush" Value="#406057" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="12,7" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#E4EFE1" /></Style>
    <Style TargetType="local:MillionScrollMetric">
        <Setter Property="Background" Value="#14191A" /><Setter Property="BorderBrush" Value="#2F3939" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12,9" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:MillionScrollMetric">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ContentPresenter ContentSource="Content" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="MillionScroll.Row" DataType="local:MillionRow">
        <Border Height="30" BorderBrush="#242B2B" BorderThickness="0,0,0,1">
            <Grid Height="30" ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="180" /><ColumnDefinition Width="104" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding IndexText}" FontSize="13" FontWeight="SemiBold" Foreground="#A3D5B9" VerticalAlignment="Center" Focusable="False" />
                <TextBlock Grid.Column="1" Text="{Binding Key}" FontSize="13" FontWeight="Normal" Foreground="#DEE4DC" VerticalAlignment="Center" Focusable="False" />
                <TextBlock Grid.Column="2" Text="{Binding Group}" FontSize="13" FontWeight="Normal" Foreground="#A3B9DA" VerticalAlignment="Center" Focusable="False" />
                <TextBlock Grid.Column="3" Text="{Binding ValueText}" FontSize="13" FontWeight="Normal" Foreground="#E3BA71" VerticalAlignment="Center" Focusable="False" />
                <TextBlock Grid.Column="4" Text="{Binding Payload}" FontSize="13" FontWeight="Normal" Foreground="#8E9791" VerticalAlignment="Center" Focusable="False" />
            </Grid>
        </Border>
    </DataTemplate>
    <Style TargetType="local:MillionScrollSurface">
        <Setter Property="Foreground" Value="#EEF1E8" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:MillionScrollSurface">
            <DockPanel>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="ScrollStates"><VisualState x:Name="Stopped" /><VisualState x:Name="Running" /></VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates"><VisualState x:Name="Wide" /><VisualState x:Name="Compact"><VisualState.Setters><Setter TargetName="PART_Sidebar" Property="DockPanel.Dock" Value="Top" /><Setter TargetName="PART_Sidebar" Property="Width" Value="Auto" /><Setter TargetName="PART_Sidebar" Property="Height" Value="280" /></VisualState.Setters></VisualState></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ScrollViewer x:Name="PART_Sidebar" DockPanel.Dock="Left" Width="330" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                    <Border Background="#191F20" BorderBrush="#333E3D" BorderThickness="0,0,1,0" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="28" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" Focusable="False" />
                            <TextBlock Text="{TemplateBinding BackendText}" FontSize="13" Foreground="#929E97" TextWrapping="Wrap" Focusable="False" />
                            <StackPanel Spacing="6"><TextBlock Text="Rows" Style="{StaticResource MillionScroll.Label}" /><NumberBox x:Name="PART_RowCount" Minimum="1" Maximum="10000000" Value="{Binding RequestedRows, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" DecimalPlaces="0" Height="36" AutomationProperties.Name="Rows" /></StackPanel>
                            <Button x:Name="PART_ApplyRows" Content="Apply rows" Style="{StaticResource MillionScroll.Action}" />
                            <StackPanel Spacing="6"><TextBlock Text="Jump to row" Style="{StaticResource MillionScroll.Label}" /><NumberBox x:Name="PART_JumpRow" Minimum="1" Maximum="{TemplateBinding JumpMaximum}" Value="{Binding JumpRow, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" DecimalPlaces="0" Height="36" AutomationProperties.Name="Jump to row" /></StackPanel>
                            <Button x:Name="PART_Jump" Content="Jump" Style="{StaticResource MillionScroll.Action}" />
                            <WrapPanel><Button x:Name="PART_Top" Content="Top" Width="88" Margin="0,0,8,4" Style="{StaticResource MillionScroll.Action}" /><Button x:Name="PART_Half" Content="Half" Width="88" Margin="0,0,8,4" Style="{StaticResource MillionScroll.Action}" /><Button x:Name="PART_Bottom" Content="Bottom" Width="88" Margin="0,0,0,4" Style="{StaticResource MillionScroll.Action}" /></WrapPanel>
                            <StackPanel Spacing="6">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Auto speed" Style="{StaticResource MillionScroll.Label}" /><TextBlock Grid.Column="1" Text="{TemplateBinding SpeedText}" FontSize="13" Foreground="#E6EBE2" Focusable="False" /></Grid>
                                <Slider x:Name="PART_Speed" Minimum="1" Maximum="10000" Value="{Binding ScrollSpeed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Height="34" AutomationProperties.Name="Auto speed" />
                            </StackPanel>
                            <Button x:Name="PART_ToggleAuto" Content="{TemplateBinding AutoButtonText}" Style="{StaticResource MillionScroll.Action}" />
                            <Border Height="1" Background="#363F3F" Margin="0,4,0,0" />
                            <local:MillionScrollMetric><local:MillionScrollMetric.Header><TextBlock Text="Rows" Style="{StaticResource MillionScroll.Label}" /></local:MillionScrollMetric.Header><TextBlock Text="{Binding RowsText, RelativeSource={RelativeSource AncestorType=local:MillionScrollSurface}}" FontSize="13" FontWeight="SemiBold" Foreground="#E6EBE2" TextAlignment="Right" TextWrapping="Wrap" Focusable="False" /></local:MillionScrollMetric>
                            <local:MillionScrollMetric><local:MillionScrollMetric.Header><TextBlock Text="Realized" Style="{StaticResource MillionScroll.Label}" /></local:MillionScrollMetric.Header><TextBlock Text="{Binding RealizedText, RelativeSource={RelativeSource AncestorType=local:MillionScrollSurface}}" FontSize="13" FontWeight="SemiBold" Foreground="#E6EBE2" TextAlignment="Right" TextWrapping="Wrap" Focusable="False" /></local:MillionScrollMetric>
                            <local:MillionScrollMetric><local:MillionScrollMetric.Header><TextBlock Text="Range" Style="{StaticResource MillionScroll.Label}" /></local:MillionScrollMetric.Header><TextBlock Text="{Binding RangeText, RelativeSource={RelativeSource AncestorType=local:MillionScrollSurface}}" FontSize="13" FontWeight="SemiBold" Foreground="#E6EBE2" TextAlignment="Right" TextWrapping="Wrap" Focusable="False" /></local:MillionScrollMetric>
                            <local:MillionScrollMetric><local:MillionScrollMetric.Header><TextBlock Text="Offset" Style="{StaticResource MillionScroll.Label}" /></local:MillionScrollMetric.Header><TextBlock Text="{Binding OffsetText, RelativeSource={RelativeSource AncestorType=local:MillionScrollSurface}}" FontSize="13" FontWeight="SemiBold" Foreground="#E6EBE2" TextAlignment="Right" TextWrapping="Wrap" Focusable="False" /></local:MillionScrollMetric>
                            <local:MillionScrollMetric><local:MillionScrollMetric.Header><TextBlock Text="Managed" Style="{StaticResource MillionScroll.Label}" /></local:MillionScrollMetric.Header><TextBlock Text="{Binding MemoryText, RelativeSource={RelativeSource AncestorType=local:MillionScrollSurface}}" FontSize="13" FontWeight="SemiBold" Foreground="#E6EBE2" TextAlignment="Right" TextWrapping="Wrap" Focusable="False" /></local:MillionScrollMetric>
                            <TextBlock Text="{TemplateBinding SelectedText}" Style="{StaticResource MillionScroll.Label}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#13191A" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" Margin="22,14,22,12"><TextBlock Text="Data stream" FontSize="18" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" Focusable="False" /><TextBlock Text="rows / shards / payloads" FontSize="12" Foreground="#909C96" Focusable="False" /></StackPanel>
                        <Border Grid.Column="1" Background="#212F2D" BorderBrush="#3F5B53" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,16,22,16"><TextBlock Text="{TemplateBinding BackendText}" FontSize="12" Foreground="#94E1B7" Focusable="False" /></Border>
                    </Grid>
                    <Border Background="#121618" BorderBrush="#2A3232" BorderThickness="0,1,0,0">
                        <local:MillionScrollListBox x:Name="PART_List" ItemsSource="{TemplateBinding RowsSource}" ItemTemplate="{StaticResource MillionScroll.Row}" SelectedIndex="{Binding SelectedRowIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" SelectionMode="Single" Background="#121618" BorderThickness="0" CornerRadius="0" />
                    </Border>
                </DockPanel>
            </DockPanel>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
