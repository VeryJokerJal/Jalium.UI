<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="AccessText">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="AccessText">
                <TextBlock x:Name="PART_TextDisplay" Focusable="False"
                           Text="{TemplateBinding DisplayText}"
                           Background="{TemplateBinding Background}"
                           Foreground="{TemplateBinding Foreground}"
                           FontFamily="{TemplateBinding ResolvedFontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           FontStyle="{TemplateBinding FontStyle}"
                           FontStretch="{TemplateBinding FontStretch}"
                           BaselineOffset="{TemplateBinding BaselineOffset}"
                           TextWrapping="{TemplateBinding TextWrapping}"
                           TextTrimming="{TemplateBinding TextTrimming}"
                           LineHeight="{TemplateBinding LineHeight}"
                           LineStackingStrategy="{TemplateBinding LineStackingStrategy}"
                           TextAlignment="{TemplateBinding ResolvedTextAlignment}"
                           TextDecorations="{TemplateBinding TextDecorations}"
                           TextEffects="{TemplateBinding TextEffects}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="AccessKeyStates">
                            <VisualState x:Name="WithAccessKey" />
                            <VisualState x:Name="WithoutAccessKey" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </TextBlock>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
