<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- DatePicker Style -->
    <!-- ============================================== -->
    <Style x:Key="DatePickerDropDownButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="4" />
        <Setter Property="Template"><ControlTemplate TargetType="Button">
            <Border x:Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Root" Property="Background" Value="{ThemeResource ControlBackgroundHover}" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="TransitionProperty" Value="Background, BorderBrush" />
        <Setter Property="TransitionDuration" Value="0:0:0.12" />
        <Setter Property="TransitionTimingFunction" Value="Recommended" />
        <Setter Property="Template">
            <ControlTemplate TargetType="DatePicker">
                <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Focused" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter TargetName="PART_Root" Property="Opacity" Value="0.55" /></VisualState.Setters></VisualState></VisualStateGroup>
                        <VisualStateGroup x:Name="DropDownStates"><VisualState x:Name="Closed" /><VisualState x:Name="Open" /></VisualStateGroup>
                        <VisualStateGroup x:Name="ValidationStates"><VisualState x:Name="Valid" /><VisualState x:Name="Invalid"><VisualState.Setters><Setter TargetName="PART_Root" Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" /></VisualState.Setters></VisualState></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <ContentPresenter x:Name="PART_Header" Content="{TemplateBinding Header}" Margin="0,0,0,4" Visibility="Collapsed"
                                          TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                          TextElement.FontFamily="{Binding PickerFontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                          TextElement.FontSize="{Binding PickerFontSize, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid x:Name="PART_InputRoot" Grid.Row="1" MinHeight="22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Text="{TemplateBinding Text}" PlaceholderText="{TemplateBinding PlaceholderText}"
                                               Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" MinWidth="0" CornerRadius="0"
                                               Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding PickerFontSize}"
                                               FontFamily="{TemplateBinding PickerFontFamily}" FontWeight="{TemplateBinding PickerFontWeight}"
                                               AutomationProperties.HelpText="{TemplateBinding ValidationMessage}" />
                            <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource DatePickerDropDownButtonStyle}" Focusable="False"
                                    Foreground="{TemplateBinding Foreground}" AutomationProperties.Name="Choose date">
                                <Path Data="M1,3 L15,3 L15,15 L1,15 Z M1,6 L15,6 M5,0 L5,4 M11,0 L11,4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"
                                      Width="14" Height="14" Stretch="Uniform" Opacity="0.72" IsHitTestVisible="False" />
                            </Button>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" StaysOpen="False">
                            <Border x:Name="PART_CalendarBorder" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource ControlBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <Calendar x:Name="PART_Calendar" Style="{TemplateBinding CalendarStyle}" FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                          IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}" FontSize="{TemplateBinding PickerFontSize}"
                                          FontFamily="{TemplateBinding PickerFontFamily}" FontWeight="{TemplateBinding PickerFontWeight}" />
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsHeaderVisible" Value="True"><Setter TargetName="PART_Header" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- Calendar Style -->
    <!-- ============================================== -->
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="TransitionProperty" Value="Background, BorderBrush" />
        <Setter Property="TransitionDuration" Value="0:0:0.12" />
        <Setter Property="TransitionTimingFunction" Value="Recommended" />

        <Setter Property="Template">
            <ControlTemplate TargetType="Calendar">
                <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter TargetName="PART_Root" Property="Opacity" Value="0.55" /></VisualState.Setters></VisualState></VisualStateGroup>
                        <VisualStateGroup x:Name="DisplayModeStates"><VisualState x:Name="Month" /><VisualState x:Name="Year" /><VisualState x:Name="Decade" /></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <CalendarItem x:Name="PART_CalendarItem" Foreground="{TemplateBinding CalendarItemForeground}" Style="{TemplateBinding CalendarItemStyle}"
                                  DisplayDate="{TemplateBinding DisplayDate}" DisplayMode="{TemplateBinding DisplayMode}"
                                  FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- Calendar parts use their own replaceable templates. -->
    <!-- ============================================== -->


    <!-- ============================================== -->
    <!-- CalendarButton Style (Month/Year buttons) -->
    <!-- ============================================== -->
    <Style TargetType="CalendarButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CalendarForeground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Foreground" Value="{Binding CalendarForeground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="TransitionProperty" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate TargetType="CalendarButton">
                <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Unselected" /><VisualState x:Name="Selected" /></VisualStateGroup>
                        <VisualStateGroup x:Name="ActiveStates"><VisualState x:Name="Active" /><VisualState x:Name="Inactive" /></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid>
                        <ContentPresenter TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <Trigger Property="HasCalendarOwner" Value="True"><Setter Property="CalendarForeground" Value="{Binding Owner.CalendarItemForeground, RelativeSource={RelativeSource Self}}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{ThemeResource HighlightBackground}" />
            </Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
                <Setter Property="CalendarForeground" Value="{ThemeResource TextOnAccent}" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="CalendarForeground" Value="{ThemeResource TextSecondary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundPressed}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="HasSelectedDays" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{ThemeResource AccentBrushPressed}" />
                <Setter Property="CalendarForeground" Value="{ThemeResource TextOnAccent}" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="CalendarForeground" Value="{ThemeResource TextDisabled}" />
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- CalendarDayButton Style -->
    <!-- ============================================== -->
    <Style TargetType="CalendarDayButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CalendarForeground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Foreground" Value="{Binding CalendarForeground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="TransitionProperty" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate TargetType="CalendarDayButton">
                <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Unselected" /><VisualState x:Name="Selected" /></VisualStateGroup>
                        <VisualStateGroup x:Name="ActiveStates"><VisualState x:Name="Active" /><VisualState x:Name="Inactive" /></VisualStateGroup>
                        <VisualStateGroup x:Name="TodayStates"><VisualState x:Name="RegularDay" /><VisualState x:Name="Today" /></VisualStateGroup>
                        <VisualStateGroup x:Name="BlackoutStates"><VisualState x:Name="Available" /><VisualState x:Name="Blackout" /></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid>
                        <ContentPresenter TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          />
                        <Border x:Name="PART_BlackoutStrike" Height="1" Background="{TemplateBinding Foreground}" Margin="4,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsBlackedOut" Value="True"><Setter TargetName="PART_BlackoutStrike" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="FontSize" Value="0"><Setter TargetName="PART_BlackoutStrike" Property="Visibility" Value="Collapsed" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <Trigger Property="HasCalendarOwner" Value="True"><Setter Property="CalendarForeground" Value="{Binding Owner.CalendarItemForeground, RelativeSource={RelativeSource Self}}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{ThemeResource HighlightBackground}" />
            </Trigger>
            <Trigger Property="IsToday" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
                <Setter Property="CalendarForeground" Value="{ThemeResource TextOnAccent}" />
            </Trigger>
            <Trigger Property="IsBlackedOut" Value="True">
                <Setter Property="CalendarForeground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="CalendarForeground" Value="{ThemeResource TextSecondary}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{ThemeResource HighlightBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundPressed}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{ThemeResource AccentBrushPressed}" />
                <Setter Property="CalendarForeground" Value="{ThemeResource TextOnAccent}" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="CalendarForeground" Value="{ThemeResource TextDisabled}" />
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- CalendarItem Style -->
    <!-- ============================================== -->
    <Style TargetType="CalendarItem">
        <Setter Property="MinWidth" Value="224" />
        <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="TransitionProperty" Value="Background, BorderBrush" />
        <Setter Property="TransitionDuration" Value="0:0:0.12" />
        <Setter Property="TransitionTimingFunction" Value="Recommended" />

        <Setter Property="Template">
            <ControlTemplate TargetType="CalendarItem">
                <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="DisplayModeStates">
                            <VisualState x:Name="Month" />
                            <VisualState x:Name="Year"><VisualState.Setters><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Decade"><VisualState.Setters><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                            <Button FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" x:Name="PART_PreviousButton" Padding="0" Background="Transparent" BorderThickness="0" MinWidth="0" MinHeight="0"
                                    IsEnabled="{TemplateBinding CanNavigatePrevious}" AutomationProperties.Name="Previous period">
                                <Path Data="M6,0 L0,5 L6,10" Width="6" Height="10" StrokeThickness="1.5" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" IsHitTestVisible="False" />
                            </Button>
                            <Button FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" x:Name="PART_HeaderButton" Grid.Column="1" Content="{TemplateBinding HeaderText}" Background="Transparent" BorderThickness="0" MinWidth="0" MinHeight="0" Padding="4,0" />
                            <Button FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" x:Name="PART_NextButton" Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" MinWidth="0" MinHeight="0"
                                    IsEnabled="{TemplateBinding CanNavigateNext}" AutomationProperties.Name="Next period">
                                <Path Data="M0,0 L6,5 L0,10" Width="6" Height="10" StrokeThickness="1.5" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" IsHitTestVisible="False" />
                            </Button>
                        </Grid>
                        <Grid x:Name="PART_MonthView" Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ItemsControl x:Name="PART_DayTitles" Height="{TemplateBinding DayTitleHeight}" FontSize="{TemplateBinding DayTitleFontSize}" ItemsSource="{Binding DayTitles, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="PART_DayItems" Height="{TemplateBinding DayGridHeight}" Grid.Row="1" ItemsSource="{Binding DayItems, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CalendarDayButton Owner="{Binding Owner}" Date="{Binding Date}" Content="{Binding Text}" Style="{Binding Style}" Visibility="{Binding Visibility}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                           IsSelected="{Binding IsSelected}" IsToday="{Binding IsToday}" IsBlackedOut="{Binding IsBlackedOut}"
                                                           IsInactive="{Binding IsInactive}" IsEnabled="{Binding IsEnabled}"
                                                           Command="{Binding SelectCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" Height="{TemplateBinding DisplayBodyHeight}" Visibility="Collapsed">
                            <ItemsControl x:Name="PART_PeriodItems" ItemsSource="{Binding PeriodItems, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" Rows="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CalendarButton Owner="{Binding Owner}" Content="{Binding Text}" Style="{Binding Style}" IsSelected="{Binding IsSelected}" Margin="2" IsInactive="{Binding IsInactive}" IsEnabled="{Binding IsEnabled}"
                                                        Command="{Binding SelectCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- DatePickerTextBox Style -->
    <!-- ============================================== -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="TransitionProperty" Value="Background, BorderBrush" />
        <Setter Property="TransitionDuration" Value="0:0:0.12" />
        <Setter Property="TransitionTimingFunction" Value="Recommended" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderHover}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
