<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:Jalium.UI.Controls.Charts">

    <!-- ============================================== -->
    <!-- Chart Shared Resources                          -->
    <!-- ============================================== -->
    <!-- Color palette for chart series -->
    <SolidColorBrush x:Key="ChartPalette1" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ChartPalette2" Color="{ThemeResource SystemFillColorCritical}" />
    <SolidColorBrush x:Key="ChartPalette3" Color="{ThemeResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="ChartPalette4" Color="{ThemeResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="ChartPalette5" Color="{ThemeResource ToastInformation}" />
    <SolidColorBrush x:Key="ChartPalette6" Color="{ThemeResource SystemAccentColorLight2}" />
    <SolidColorBrush x:Key="ChartPalette7" Color="{ThemeResource SystemAccentColorDark2}" />
    <SolidColorBrush x:Key="ChartPalette8" Color="{ThemeResource ToastSuccess}" />
    <SolidColorBrush x:Key="ChartPalette9" Color="{ThemeResource ToastWarning}" />
    <SolidColorBrush x:Key="ChartPalette10" Color="{ThemeResource SystemFillColorNeutral}" />

    <!-- Chart theme brushes -->
    <SolidColorBrush x:Key="ChartBackground" Color="{ThemeResource ControlFillColorTransparent}" />
    <SolidColorBrush x:Key="ChartForeground" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="ChartGridLine" Color="{ThemeResource DividerStrokeColorDefault}" />
    <SolidColorBrush x:Key="ChartAxis" Color="{ThemeResource ControlStrongStrokeColorDefault}" />

    <!-- ============================================== -->
    <!-- LineChart Style                                  -->
    <!-- ============================================== -->
    <ItemsPanelTemplate x:Key="ChartBase.LegendHorizontal"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="ChartBase.LegendVertical"><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
    <ControlTemplate x:Key="ChartBase.Template" TargetType="ChartBase">
        <Grid Name="PART_Root">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup Name="CommonStates"><VisualState Name="Normal" /><VisualState Name="Disabled" /></VisualStateGroup>
                <VisualStateGroup Name="LegendStates">
                    <VisualState Name="LegendHorizontal" />
                    <VisualState Name="LegendVertical"><VisualState.Setters>
                        <Setter TargetName="PART_Legend" Property="ItemsPanel" Value="{StaticResource ChartBase.LegendVertical}" />
                        <Setter TargetName="PART_LegendScroll" Property="HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter TargetName="PART_LegendScroll" Property="VerticalScrollBarVisibility" Value="Auto" />
                    </VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <Grid Clip="{TemplateBinding ChartContentClip}">
                <ChartPlotView Name="PART_PlotView" Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                <Canvas>
                    <TextBlock Name="PART_Title" Text="{TemplateBinding Title}" Foreground="{TemplateBinding ResolvedTitleForeground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding TitleFontSize}" LineHeight="{TemplateBinding ChartTitleLineHeight}" FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{TemplateBinding ChartTitleVisibility}" IsHitTestVisible="False"
                        Canvas.Left="{Binding ChartTitleBounds.X, RelativeSource={RelativeSource TemplatedParent}}" Canvas.Top="{Binding ChartTitleBounds.Y, RelativeSource={RelativeSource TemplatedParent}}" Width="{Binding ChartTitleBounds.Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding ChartTitleBounds.Height, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ScrollViewer Name="PART_LegendScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{TemplateBinding LegendVisibility}"
                        Canvas.Left="{Binding LegendBounds.X, RelativeSource={RelativeSource TemplatedParent}}" Canvas.Top="{Binding LegendBounds.Y, RelativeSource={RelativeSource TemplatedParent}}" Width="{Binding LegendBounds.Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding LegendBounds.Height, RelativeSource={RelativeSource TemplatedParent}}">
                        <ChartLegend Name="PART_Legend" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" Items="{TemplateBinding LegendItems}" Orientation="{TemplateBinding LegendOrientation}" ItemsPanel="{StaticResource ChartBase.LegendHorizontal}" Padding="0" FontSize="12" />
                    </ScrollViewer>
                    <ChartTooltip Name="PART_Tooltip" SeriesTitle="{Binding DefaultTooltipInfo.SeriesTitle, RelativeSource={RelativeSource TemplatedParent}}" XValue="{Binding DefaultTooltipInfo.XValue, RelativeSource={RelativeSource TemplatedParent}}" YValue="{Binding DefaultTooltipInfo.YValue, RelativeSource={RelativeSource TemplatedParent}}" SeriesBrush="{Binding DefaultTooltipInfo.SeriesBrush, RelativeSource={RelativeSource TemplatedParent}}"
                        Content="{TemplateBinding TooltipContent}" ContentTemplate="{TemplateBinding TooltipTemplate}" Visibility="{TemplateBinding TooltipVisibility}" MaxWidth="{TemplateBinding TooltipMaxWidth}" MaxHeight="{TemplateBinding TooltipMaxHeight}" IsHitTestVisible="False"
                        Canvas.Left="{Binding TooltipBounds.X, RelativeSource={RelativeSource TemplatedParent}}" Canvas.Top="{Binding TooltipBounds.Y, RelativeSource={RelativeSource TemplatedParent}}" />
                </Canvas>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ChartBase">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="LineChart">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- BarChart Style                                   -->
    <!-- ============================================== -->
    <Style TargetType="BarChart">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- PieChart Style                                   -->
    <!-- ============================================== -->
    <Style TargetType="PieChart">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- ScatterPlot Style                                -->
    <!-- ============================================== -->
    <Style TargetType="ScatterPlot">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- Heatmap Style                                    -->
    <!-- ============================================== -->
    <Style TargetType="Heatmap">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- Sparkline Style                                  -->
    <!-- ============================================== -->
    <Style TargetType="Sparkline">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorTransparentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Template"><ControlTemplate TargetType="Sparkline">
            <Grid Name="PART_Root">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates"><VisualState Name="Normal" /><VisualState Name="Disabled" /></VisualStateGroup>
                    <VisualStateGroup Name="DataStates"><VisualState Name="Empty" /><VisualState Name="Populated" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                <Grid Clip="{TemplateBinding SparklineContentClip}"><SparklinePlotView Name="PART_PlotView" Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}" /></Grid>
            </Grid>
        </ControlTemplate></Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- GaugeChart Style                                 -->
    <!-- ============================================== -->
    <Style TargetType="GaugeChart">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- TreeMap Style                                    -->
    <!-- ============================================== -->
    <Style TargetType="TreeMap">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- CandlestickChart Style                           -->
    <!-- ============================================== -->
    <Style TargetType="CandlestickChart">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- NetworkGraph Style                               -->
    <!-- ============================================== -->
    <Style TargetType="NetworkGraph">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="200" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- GanttChart Style                                 -->
    <!-- ============================================== -->
    <Style TargetType="GanttChart">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="MinHeight" Value="200" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- SankeyDiagram Style                              -->
    <!-- ============================================== -->
    <Style TargetType="SankeyDiagram">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="MinHeight" Value="200" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- ChartLegend Style                                -->
    <!-- ============================================== -->
    <BooleanToVisibilityConverter x:Key="ChartLegend.Visibility" />
    <DataTemplate x:Key="ChartLegend.Item"><Border Padding="0" Margin="0,0,16,4" Visibility="{Binding IsVisible, Converter={StaticResource ChartLegend.Visibility}}"><StackPanel Orientation="Horizontal" Spacing="4"><Rectangle Width="12" Height="12" StrokeThickness="0" Fill="{Binding Brush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ChartLegend}}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ChartLegend}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ChartLegend}}" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ChartLegend}}" VerticalAlignment="Center" /></StackPanel></Border></DataTemplate>
    <ItemsPanelTemplate x:Key="ChartLegend.Panel"><WrapPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ChartLegend}}" /></ItemsPanelTemplate>
    <Style TargetType="ChartLegend">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorTransparentBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource ControlFillColorTransparentBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="4" /><Setter Property="FontSize" Value="11" />
        <Setter Property="ItemTemplate" Value="{StaticResource ChartLegend.Item}" /><Setter Property="ItemsPanel" Value="{StaticResource ChartLegend.Panel}" />
        <Setter Property="Template"><ControlTemplate TargetType="ChartLegend"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState></VisualStateGroup><VisualStateGroup x:Name="LayoutStates"><VisualState x:Name="Horizontal" /><VisualState x:Name="Vertical" /></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <ItemsControl x:Name="PART_Items" ItemsSource="{TemplateBinding Items}" ItemTemplate="{TemplateBinding ItemTemplate}" ItemContainerStyle="{TemplateBinding ItemContainerStyle}" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ChartTooltip">
        <Setter Property="Background" Value="{ThemeResource ControlBackground}" /><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="8,6" /><Setter Property="FontSize" Value="12" /><Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><ControlTemplate TargetType="ChartTooltip"><Border Shape="RoundedRectangle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="TitleStates"><VisualState x:Name="HasTitle" /><VisualState x:Name="NoTitle"><VisualState.Setters><Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="XValueStates"><VisualState x:Name="HasXValue" /><VisualState x:Name="NoXValue"><VisualState.Setters><Setter TargetName="PART_XValue" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="YValueStates"><VisualState x:Name="HasYValue" /><VisualState x:Name="NoYValue"><VisualState.Setters><Setter TargetName="PART_YValue" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="MarkerStates"><VisualState x:Name="HasSeriesBrush" /><VisualState x:Name="NoSeriesBrush"><VisualState.Setters><Setter TargetName="PART_Marker" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4"><Rectangle x:Name="PART_Marker" Width="8" Height="8" StrokeThickness="0" Fill="{TemplateBinding SeriesBrush}" VerticalAlignment="Center" /><TextBlock x:Name="PART_Title" Text="{TemplateBinding SeriesTitle}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" /></StackPanel>
                <TextBlock x:Name="PART_XValue" Text="{Binding XValue, RelativeSource={RelativeSource TemplatedParent}, StringFormat='X: {0}'}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" Margin="0,0,0,2" />
                <TextBlock x:Name="PART_YValue" Text="{Binding YValue, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Y: {0}'}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
                <ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" />
            </StackPanel>
        </Border></ControlTemplate></Setter>
    </Style>

    <Style TargetType="charts:FlowchartDiagram">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="NodeFill" Value="{ThemeResource LayerFillColorAltBrush}" />
        <Setter Property="NodeBorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="NodeForeground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="EdgeBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="EdgeLabelBackground" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="EdgeLabelForeground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template" Value="{StaticResource ChartBase.Template}" />
    </Style>
</ResourceDictionary>
