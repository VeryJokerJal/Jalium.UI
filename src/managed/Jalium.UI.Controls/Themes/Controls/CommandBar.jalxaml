<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Controls">

    <ItemsPanelTemplate x:Key="CommandBar.PrimaryPanel">
        <WrapPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="CommandBar.SecondaryPanel">
        <StackPanel Orientation="Vertical" />
    </ItemsPanelTemplate>

    <ControlTemplate x:Key="CommandBar.OverflowSurfaceTemplate" TargetType="ContentControl">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
    </ControlTemplate>

    <Style TargetType="CommandBar">
        <Setter Property="Background" Value="{ThemeResource CommandBarBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CommandBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Template">
            <ControlTemplate TargetType="CommandBar">
                <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="OpenStates"><VisualState x:Name="Open" /><VisualState x:Name="Closed" /></VisualStateGroup>
                        <VisualStateGroup x:Name="DisplayStates">
                            <VisualState x:Name="Expanded" />
                            <VisualState x:Name="Compact" />
                            <VisualState x:Name="Minimal"><VisualState.Setters>
                                <Setter TargetName="PART_PrimaryItemsControl" Property="Visibility" Value="Collapsed" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="Hidden"><VisualState.Setters>
                                <Setter TargetName="PART_Root" Property="Visibility" Value="Collapsed" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="OverflowButtonStates">
                            <VisualState x:Name="OverflowButtonVisible" />
                            <VisualState x:Name="OverflowButtonHidden"><VisualState.Setters>
                                <Setter TargetName="PART_MoreButton" Property="Visibility" Value="Collapsed" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled"><VisualState.Setters>
                                <Setter TargetName="PART_Root" Property="Opacity" Value="0.56" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ItemsControl x:Name="PART_PrimaryItemsControl" ItemsSource="{TemplateBinding PrimaryCommands}"
                                      ItemsPanel="{StaticResource CommandBar.PrimaryPanel}" VerticalAlignment="Center"
                                      CommandBar.LabelPosition="{TemplateBinding DefaultLabelPosition}" />
                        <Button x:Name="PART_MoreButton" Grid.Column="1" Content="&#x22EF;" Width="40" MinWidth="40"
                                Padding="0" BorderThickness="0" Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                ToolTip="More commands" automation:AutomationProperties.Name="More commands" />
                        <Popup x:Name="PART_OverflowPopup" Grid.ColumnSpan="2" Placement="Bottom" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=PART_MoreButton}" IsOpen="{TemplateBinding IsOverflowOpen}">
                            <ContentControl x:Name="PART_OverflowBorder" Template="{StaticResource CommandBar.OverflowSurfaceTemplate}"
                                            MinWidth="200" MaxWidth="480" Padding="4" CornerRadius="8"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding EffectiveOverflowBackground}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                                    <ItemsControl x:Name="PART_SecondaryItemsControl" ItemsSource="{TemplateBinding SecondaryCommands}"
                                                  ItemsPanel="{StaticResource CommandBar.SecondaryPanel}" CommandBar.LabelPosition="Right" />
                                </ScrollViewer>
                            </ContentControl>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ClosedDisplayMode" Value="Hidden" />
                    <Condition Property="IsOpen" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="MinHeight" Value="0" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
