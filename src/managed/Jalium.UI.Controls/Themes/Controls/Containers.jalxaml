<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Jalium.UI.Automation">

    <Style TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource MenuFlyoutPresenterBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MenuFlyoutPresenterBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <ControlTemplate TargetType="FlyoutPresenter">
                <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled" /></VisualStateGroup>
                        <VisualStateGroup x:Name="PopupStates"><VisualState x:Name="Closed" /><VisualState x:Name="Open" /></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" TextElement.FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}" TextElement.FontFamily="{Binding FontFamily, RelativeSource={RelativeSource TemplatedParent}}" TextElement.FontWeight="{Binding FontWeight, RelativeSource={RelativeSource TemplatedParent}}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- Border Style -->
    <!-- ============================================== -->
    <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
    </Style>

    <!-- ============================================== -->
    <!-- InfoBar Style -->
    <!-- ============================================== -->
    <Style TargetType="InfoBar">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Padding" Value="14,10,14,10" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Template"><ControlTemplate TargetType="InfoBar"><Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="OpenStates"><VisualState x:Name="Open" /><VisualState x:Name="Closed"><VisualState.Setters><Setter Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="SeverityStates"><VisualState x:Name="Information" /><VisualState x:Name="Success"><VisualState.Setters><Setter TargetName="PART_SeverityBackground" Property="Background" Value="{ThemeResource InfoBarSuccessBackground}" /><Setter TargetName="PART_DefaultIcon" Property="Stroke" Value="{ThemeResource InfoBarSuccessBrush}" /><Setter TargetName="PART_DefaultIcon" Property="Data" Value="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M6,10 L9,13 L14,7" /></VisualState.Setters></VisualState><VisualState x:Name="Warning"><VisualState.Setters><Setter TargetName="PART_SeverityBackground" Property="Background" Value="{ThemeResource InfoBarWarningBackground}" /><Setter TargetName="PART_DefaultIcon" Property="Stroke" Value="{ThemeResource InfoBarWarningBrush}" /><Setter TargetName="PART_DefaultIcon" Property="Data" Value="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M10,5 L10,11 M10,14 L10,15" /></VisualState.Setters></VisualState><VisualState x:Name="Error"><VisualState.Setters><Setter TargetName="PART_SeverityBackground" Property="Background" Value="{ThemeResource InfoBarErrorBackground}" /><Setter TargetName="PART_DefaultIcon" Property="Stroke" Value="{ThemeResource InfoBarErrorBrush}" /><Setter TargetName="PART_DefaultIcon" Property="Data" Value="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M7,7 L13,13 M13,7 L7,13" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="IconStates"><VisualState x:Name="IconVisible" /><VisualState x:Name="IconHidden"><VisualState.Setters><Setter TargetName="PART_IconHost" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="IconSourceStates"><VisualState x:Name="DefaultIcon" /><VisualState x:Name="CustomIcon"><VisualState.Setters><Setter TargetName="PART_DefaultIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_CustomIcon" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="CloseStates"><VisualState x:Name="Closable" /><VisualState x:Name="NotClosable"><VisualState.Setters><Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="TitleStates"><VisualState x:Name="HasTitle" /><VisualState x:Name="NoTitle"><VisualState.Setters><Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="MessageStates"><VisualState x:Name="HasMessage" /><VisualState x:Name="NoMessage"><VisualState.Setters><Setter TargetName="PART_Message" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="ActionStates"><VisualState x:Name="HasAction" /><VisualState x:Name="NoAction"><VisualState.Setters><Setter TargetName="PART_Action" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="PART_SeverityBackground" Background="{ThemeResource InfoBarInformationalBackground}" CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid x:Name="PART_IconHost" Width="20" Height="20" Margin="0,2,12,0" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Path x:Name="PART_DefaultIcon" Width="20" Height="20" Stroke="{ThemeResource InfoBarInfoBrush}" StrokeThickness="2" Stretch="None" Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M10,8 L10,14 M10,5 L10,6" />
                        <IconSourceElement x:Name="PART_CustomIcon" IconSource="{TemplateBinding IconSource}" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PART_Message" Text="{TemplateBinding Message}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        <ContentPresenter x:Name="PART_Action" Content="{TemplateBinding ActionButton}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button x:Name="PART_CloseButton" Grid.Column="2" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Margin="12,0,0,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" Foreground="{TemplateBinding Foreground}" automation:AutomationProperties.Name="关闭通知">
                        <Path Width="12" Height="12" Data="M1,1 L11,11 M11,1 L1,11" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Stretch="Uniform" IsHitTestVisible="False" />
                    </Button>
                </Grid>
            </Border>
        </Grid></ControlTemplate></Setter>
    </Style>

    <!-- ============================================== -->
    <!-- ToastNotificationItem Style -->
    <!-- ============================================== -->
    <Style TargetType="ToastNotificationItem">
        <Setter Property="Background" Value="{ThemeResource ToastInformationBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource ToastForeground}" />
        <Setter Property="IconForeground" Value="{ThemeResource ToastInformationIcon}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToastNotificationItem">
            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"><VisualState.Setters><Setter TargetName="RootBorder" Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter TargetName="RootBorder" Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="OpenStates"><VisualState x:Name="Open" /><VisualState x:Name="Closed" /></VisualStateGroup>
                    <VisualStateGroup x:Name="SeverityStates"><VisualState x:Name="Information" /><VisualState x:Name="Success" /><VisualState x:Name="Warning" /><VisualState x:Name="Error" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <SymbolIcon x:Name="PART_Icon" Symbol="Info" Width="20" Height="20" Margin="0,0,12,0" Foreground="{TemplateBinding IconForeground}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="PART_TitleText" Text="{TemplateBinding Title}" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" Focusable="False" />
                        <TextBlock x:Name="PART_MessageText" Text="{TemplateBinding Message}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" Focusable="False" />
                        <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        <ContentPresenter x:Name="PART_ActionHost" Content="{TemplateBinding ActionButton}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button x:Name="PART_CloseButton" Grid.Column="2" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="6" Margin="8,0,0,0"
                            Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" ToolTip="Dismiss notification"
                            automation:AutomationProperties.Name="Dismiss notification">
                        <SymbolIcon Symbol="Cancel" Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsIconVisible" Value="False"><Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="IsClosable" Value="False"><Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Title" Value="{x:Null}"><Setter TargetName="PART_TitleText" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Title" Value=""><Setter TargetName="PART_TitleText" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Message" Value="{x:Null}"><Setter TargetName="PART_MessageText" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Message" Value=""><Setter TargetName="PART_MessageText" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="HasContent" Value="False"><Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="ActionButton" Value="{x:Null}"><Setter TargetName="PART_ActionHost" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Severity" Value="Success"><Setter TargetName="PART_Icon" Property="Symbol" Value="Accept" /></Trigger>
                <Trigger Property="Severity" Value="Warning"><Setter TargetName="PART_Icon" Property="Symbol" Value="Warning" /></Trigger>
                <Trigger Property="Severity" Value="Error"><Setter TargetName="PART_Icon" Property="Symbol" Value="Error" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Severity" Value="Success"><Setter Property="Background" Value="{ThemeResource ToastSuccessBackground}" /><Setter Property="IconForeground" Value="{ThemeResource ToastSuccessIcon}" /></Trigger>
            <Trigger Property="Severity" Value="Warning"><Setter Property="Background" Value="{ThemeResource ToastWarningBackground}" /><Setter Property="IconForeground" Value="{ThemeResource ToastWarningIcon}" /></Trigger>
            <Trigger Property="Severity" Value="Error"><Setter Property="Background" Value="{ThemeResource ToastErrorBackground}" /><Setter Property="IconForeground" Value="{ThemeResource ToastErrorIcon}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- ToastNotificationHost Style -->
    <!-- ============================================== -->
    <Style TargetType="ToastNotificationHost">
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- ============================================== -->
    <!-- ScrollViewer Style -->
    <!-- ============================================== -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ScrollViewer">
                <Grid x:Name="ScrollViewerRoot">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"><VisualState.Setters><Setter TargetName="ScrollViewerRoot" Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter TargetName="ScrollViewerRoot" Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="ScrollBarStates"><VisualState x:Name="NoScrollBars" /><VisualState x:Name="HorizontalScrollBar" /><VisualState x:Name="VerticalScrollBar" /><VisualState x:Name="BothScrollBars" /></VisualStateGroup>
                        <VisualStateGroup x:Name="ScrollBarModeStates"><VisualState x:Name="ClassicScrollBars" /><VisualState x:Name="OverlayScrollBars" /></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding ChromePadding}" IsHitTestVisible="False" />
                    <ScrollViewerLayoutPanel x:Name="PART_LayoutPanel">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" Focusable="False" Cursor="Arrow"
                                   SmallChange="16" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   IsOverlayStyle="{TemplateBinding IsOverlayScrollBarEnabled}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" Focusable="False" Cursor="Arrow"
                                   SmallChange="16" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   IsOverlayStyle="{TemplateBinding IsOverlayScrollBarEnabled}" />
                    </ScrollViewerLayoutPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- VirtualizingStackPanel Style -->
    <!-- ============================================== -->
    <Style TargetType="VirtualizingStackPanel">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================================== -->
    <!-- ToolTip Style -->
    <!-- ============================================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{ThemeResource TooltipBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="{ThemeResource CaptionFontSize}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToolTip">
                <Border Name="ToolTipBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Shape="RoundedRectangle"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- GroupBox Style -->
    <!-- ============================================== -->
    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14,16,14" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeaderBackground" Value="{ThemeResource LayerFillColorAltBrush}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="GroupBox">
                <Grid>
                    <!-- Content Border with gap for header -->
                    <Border Name="PART_ContentBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Shape="RoundedRectangle"
                            Margin="0,10,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                    </Border>

                    <Grid Name="PART_HeaderBorder"
                          Background="{TemplateBinding HeaderBackground}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          IsHitTestVisible="False"
                          Margin="8,0,0,0">
                        <ContentPresenter Name="PART_Header"
                                          Content="{TemplateBinding Header}"
                                          Margin="10,2,10,2" />
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- Expander Style -->
    <!-- ============================================== -->
    <Style TargetType="Expander">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeaderBackground" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Expander">
                <Grid>
                    <Border Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Shape="RoundedRectangle"
                            ClipToBounds="True">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Name="PART_HeaderBorder"
                                  Background="{TemplateBinding HeaderBackground}"
                                  TransitionProperty="Background"
                                  TransitionDuration="0:0:0.12"
                                  TransitionTimingFunction="Recommended">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Chevron (right arrow = collapsed) -->
                                    <Path Name="PART_Chevron"
                                          Grid.Column="0"
                                          Data="M333.414 23.989 l557.904 393.923 c58.785 42.21 58.785 147.737 0 189.948 l-557.904 395.106 c-58.785 42.21-155.948 11.943-155.948-72.478 v-835.205 c0-84.421 97.162-113.505 155.948-71.293 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          Width="8"
                                          Height="10"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />

                                    <!-- Header Content -->
                                    <ContentPresenter Name="PART_HeaderContent"
                                                      Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <!-- Content -->
                            <Grid Name="PART_ContentBorder"
                                  Visibility="Collapsed">
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_HeaderBorder" Property="Background" Value="{ThemeResource ControlBackgroundHover}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <!-- IsExpanded is handled by ExpandCollapseAnimator in code-behind (smooth animation) -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- GridSplitter Style -->
    <!-- ============================================== -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{ThemeResource ControlBorder}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="GridSplitter">
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}" />
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_Root" Property="Background" Value="{ThemeResource AccentBrush}" />
                    </Trigger>
                    <!-- 拖动态走模板层：GridSplitter 代码里不再写 Background 本地值，
                         否则拖完一次就会把使用者自己设的 Background 抹掉。 -->
                    <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="PART_Root" Property="Background" Value="{ThemeResource AccentBrushPressed}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

</ResourceDictionary>
