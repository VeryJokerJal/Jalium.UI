<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dev="clr-namespace:Jalium.UI.Controls.DevTools"
                    xmlns:automation="clr-namespace:Jalium.UI.Automation">
    <Style x:Key="DevTools.TreeExpander" TargetType="Button">
        <Setter Property="Focusable" Value="False" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="16" /><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource DevTools.TextPrimary}" />
        <Setter Property="Template"><ControlTemplate TargetType="Button">
            <Border Name="PART_Surface" Background="{TemplateBinding Background}" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Surface" Property="Background" Value="{DynamicResource DevTools.ControlHover}" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter>
    </Style>
    <Style TargetType="dev:DevToolsTreeItem">
        <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="0" /><Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource DevTools.TextPrimary}" />
        <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}" /><Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TransitionProperty" Value="None" />
        <Setter Property="Template"><ControlTemplate TargetType="dev:DevToolsTreeItem">
            <Grid>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="NodeStates"><VisualState x:Name="Branch" /><VisualState x:Name="Leaf"><VisualState.Setters><Setter TargetName="PART_Expander" Property="Visibility" Value="Hidden" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="ExpansionStates"><VisualState x:Name="Expanded" /><VisualState x:Name="Collapsed" /></VisualStateGroup>
                    <VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Unselected" /><VisualState x:Name="Selected"><VisualState.Setters><Setter TargetName="PART_Selection" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="MouseOver"><VisualState.Setters><Setter TargetName="PART_Hover" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" /><VisualState x:Name="Focused"><VisualState.Setters><Setter TargetName="PART_Focus" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                <Border Name="PART_Hover" Background="{DynamicResource DevTools.ControlHover}" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border Name="PART_Selection" Background="{DynamicResource DevTools.AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False" />
                <Grid Name="PART_RevealContent" Margin="{TemplateBinding Padding}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="{TemplateBinding IndentWidth}" />
                    <Button Name="PART_Expander" Grid.Column="1" Style="{StaticResource DevTools.TreeExpander}" automation:AutomationProperties.Name="{TemplateBinding Content}">
                        <Path Name="PART_Chevron" Data="M 733.87,841.90 L 1160.54,273.07 A 170.67,170.67,0,0,0,1024.00,0 H 170.67 A 170.67,170.67,0,0,0,34.14,273.07 L 460.80,841.90 A 170.67,170.67,0,0,0,733.87,841.90 Z" Fill="{TemplateBinding Foreground}" Width="8" Height="8" Stretch="Uniform">
                            <Path.RenderTransform><RotateTransform Angle="-90" CenterX="4" CenterY="4" /></Path.RenderTransform>
                        </Path>
                    </Button>
                    <ContentPresenter Name="PART_Content" Grid.Column="2" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
                <Border Name="PART_Focus" BorderBrush="{DynamicResource DevTools.Accent}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
        </ControlTemplate></Setter>
    </Style>
    <Style TargetType="dev:DevToolsInspector">
        <Setter Property="Background" Value="{DynamicResource DevTools.SurfaceAlt}" /><Setter Property="Foreground" Value="{DynamicResource DevTools.TextPrimary}" />
        <Setter Property="Template"><ControlTemplate TargetType="dev:DevToolsInspector">
            <Grid Background="{TemplateBinding Background}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="LayoutStates"><VisualState Name="Wide" /><VisualState Name="Compact"><VisualState.Setters>
                        <Setter TargetName="PART_TreeColumn" Property="Width" Value="*" /><Setter TargetName="PART_SplitterColumn" Property="Width" Value="0" /><Setter TargetName="PART_DetailsColumn" Property="Width" Value="0" />
                        <Setter TargetName="PART_TreeRow" Property="Height" Value="0.42*" /><Setter TargetName="PART_DetailsRow" Property="Height" Value="*" />
                        <Setter TargetName="PART_TreePane" Property="Grid.ColumnSpan" Value="3" />
                        <Setter TargetName="PART_DetailsPane" Property="Grid.Column" Value="0" /><Setter TargetName="PART_DetailsPane" Property="Grid.Row" Value="2" /><Setter TargetName="PART_DetailsPane" Property="Grid.ColumnSpan" Value="3" />
                        <Setter TargetName="PART_Splitter" Property="Grid.Column" Value="0" /><Setter TargetName="PART_Splitter" Property="Grid.Row" Value="1" /><Setter TargetName="PART_Splitter" Property="Grid.ColumnSpan" Value="3" />
                        <Setter TargetName="PART_Splitter" Property="Width" Value="NaN" /><Setter TargetName="PART_Splitter" Property="Height" Value="6" /><Setter TargetName="PART_Splitter" Property="ResizeDirection" Value="Rows" />
                    </VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup Name="DataStates"><VisualState Name="DetailsAvailable" /><VisualState Name="DetailsEmpty"><VisualState.Setters>
                        <Setter TargetName="PART_DetailsScrollViewer" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_EmptyDetails" Property="Visibility" Value="Visible" />
                    </VisualState.Setters></VisualState></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <dev:DevToolsSurface Kind="Toolbar">
                    <WrapPanel>
                        <dev:DevToolsActionButton Name="PART_Refresh" Label="Refresh" Icon="↻" Command="{TemplateBinding RefreshCommand}" />
                        <dev:DevToolsActionButton Name="PART_Pick" Label="Pick" Icon="◎" IsActive="{TemplateBinding IsPicking}" Command="{TemplateBinding PickCommand}" />
                        <Border Style="{StaticResource DevTools.VerticalDivider}" />
                        <dev:DevToolsActionButton Name="PART_Expand" Label="Expand" Icon="⊕" Command="{TemplateBinding ExpandCommand}" />
                        <dev:DevToolsActionButton Name="PART_Collapse" Label="Collapse" Icon="⊖" Command="{TemplateBinding CollapseCommand}" />
                        <Border Style="{StaticResource DevTools.VerticalDivider}" />
                        <dev:DevToolsActionButton Name="PART_Copy" Label="Copy" Icon="⧉" Command="{TemplateBinding CopyCommand}" />
                        <Border Style="{StaticResource DevTools.VerticalDivider}" />
                        <dev:DevToolsActionButton Name="PART_Delete" Label="Delete" Icon="✕" Variant="Danger" Command="{TemplateBinding DeleteCommand}" IsEnabled="{TemplateBinding CanDelete}" ToolTip="{TemplateBinding DeleteToolTip}" />
                        <dev:DevToolsActionButton Name="PART_Undo" Label="Undo" Icon="↩" Command="{TemplateBinding UndoCommand}" IsEnabled="{TemplateBinding CanUndo}" ToolTip="{TemplateBinding UndoToolTip}" />
                    </WrapPanel>
                </dev:DevToolsSurface>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Name="PART_TreeColumn" Width="*" /><ColumnDefinition Name="PART_SplitterColumn" Width="Auto" /><ColumnDefinition Name="PART_DetailsColumn" Width="1.2*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Name="PART_TreeRow" Height="*" /><RowDefinition Height="Auto" /><RowDefinition Name="PART_DetailsRow" Height="0" /></Grid.RowDefinitions>
                    <Grid Name="PART_TreePane">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource DevTools.Chrome}" BorderBrush="{DynamicResource DevTools.BorderSubtle}" BorderThickness="0,0,0,1" Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Name="PART_SearchBox" Style="{StaticResource DevTools.TextInput}" PlaceholderText="Filter tree…" automation:AutomationProperties.Name="Filter tree" Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <dev:DevToolsSegmentedSelector Name="PART_ViewSelector" Grid.Column="1" automation:AutomationProperties.Name="Tree projection">
                                    <dev:DevToolsSegmentItem Content="≡" automation:AutomationProperties.Name="Flat list" ToolTip="Flat list" />
                                    <dev:DevToolsSegmentItem Content="▦" automation:AutomationProperties.Name="Visual tree" ToolTip="Visual tree" />
                                    <dev:DevToolsSegmentItem Content="⧉" automation:AutomationProperties.Name="Logical tree" ToolTip="Logical tree" />
                                </dev:DevToolsSegmentedSelector>
                            </Grid>
                        </Border>
                        <ContentPresenter Name="PART_TreeContent" Grid.Row="1" Content="{TemplateBinding TreeContent}" />
                    </Grid>
                    <GridSplitter Name="PART_Splitter" Grid.Column="1" Width="6" Background="{DynamicResource DevTools.BorderSubtle}" ResizeDirection="Columns" />
                    <Border Name="PART_DetailsPane" Grid.Column="2" Background="{DynamicResource DevTools.SurfaceAlt}" ClipToBounds="True" Padding="8,4">
                        <Grid>
                            <ScrollViewer Name="PART_DetailsScrollViewer" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalScrollBarVisibility="{TemplateBinding DetailsHorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding DetailsVerticalScrollBarVisibility}"><ContentPresenter Name="PART_DetailsContent" HorizontalAlignment="Stretch" Content="{TemplateBinding DetailsContent}" /></ScrollViewer>
                            <TextBlock Name="PART_EmptyDetails" Text="{TemplateBinding EmptyText}" Foreground="{DynamicResource DevTools.TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="8,16" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ControlTemplate></Setter>
    </Style>
</ResourceDictionary>
