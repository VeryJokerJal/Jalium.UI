<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dev="clr-namespace:Jalium.UI.Controls.DevTools"
                    xmlns:automation="clr-namespace:Jalium.UI.Automation">
    <Style x:Key="DevTools.LayoutItem" TargetType="ListBoxItem" BasedOn="{StaticResource DevTools.DiagnosticsItem}">
        <Setter Property="automation:AutomationProperties.Name" Value="{Binding ElementName}" />
    </Style>
    <Style x:Key="DevTools.LayoutList" TargetType="ListBox" BasedOn="{StaticResource DevTools.DiagnosticsList}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource DevTools.LayoutItem}" />
    </Style>
    <Style x:Key="DevTools.LayoutMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource DevTools.MutedText}">
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="DevTools.LayoutMetricValue" TargetType="TextBlock" BasedOn="{StaticResource DevTools.MonoText}">
        <Setter Property="FontSize" Value="10" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="TextAlignment" Value="Right" />
    </Style>
    <DataTemplate x:Key="DevTools.LayoutStatsTemplate">
        <Border Background="{DynamicResource DevTools.Chrome}" BorderBrush="{DynamicResource DevTools.BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="4,0,4,6">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource DevTools.SurfaceAlt}" BorderBrush="{DynamicResource DevTools.BorderSubtle}" BorderThickness="1" CornerRadius="4" Height="22">
                        <TextBlock Text="{Binding Rank}" Style="{StaticResource DevTools.MonoText}" FontSize="10" TextAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding ElementName}" ToolTip="{Binding ElementName}" Style="{StaticResource DevTools.MonoText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="8,0" />
                    <dev:DevToolsActionButton Name="PART_Reveal" Grid.Column="2" Label="Reveal" Icon="↗"
                        Command="{Binding RevealCommand, RelativeSource={RelativeSource AncestorType={x:Type dev:DevToolsLayoutProfiler}}}" CommandParameter="{Binding}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Name="PART_MeasureLabel" Text="Measure" Style="{StaticResource DevTools.LayoutMetricLabel}" Margin="0,0,0,2" />
                    <TextBlock Grid.Column="1" Text="{Binding MeasureText}" ToolTip="{Binding MeasureText}" Style="{StaticResource DevTools.LayoutMetricValue}" Margin="0,0,0,2" />
                    <dev:DevToolsMeter Name="PART_MeasureMeter" Grid.Row="1" Grid.ColumnSpan="2" Label="Measure cost" Value="{Binding MeasureFraction}" ProgressBrush="{DynamicResource DevTools.Info}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Name="PART_ArrangeLabel" Text="Arrange" Style="{StaticResource DevTools.LayoutMetricLabel}" Margin="0,0,0,2" />
                    <TextBlock Grid.Column="1" Text="{Binding ArrangeText}" ToolTip="{Binding ArrangeText}" Style="{StaticResource DevTools.LayoutMetricValue}" Margin="0,0,0,2" />
                    <dev:DevToolsMeter Name="PART_ArrangeMeter" Grid.Row="1" Grid.ColumnSpan="2" Label="Arrange cost" Value="{Binding ArrangeFraction}" ProgressBrush="{DynamicResource DevTools.Warning}" />
                </Grid>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Name="PART_InvalidationLabel" Text="Invalidate" Style="{StaticResource DevTools.LayoutMetricLabel}" Margin="0,0,0,2" />
                    <TextBlock Grid.Column="1" Text="{Binding InvalidationText}" Style="{StaticResource DevTools.LayoutMetricValue}" Margin="0,0,0,2" />
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource DevTools.GridLine}" CornerRadius="2.5" ClipToBounds="True">
                        <dev:DevToolsProportionalPanel Name="PART_InvalidationStrip">
                            <Border Background="{DynamicResource DevTools.Info}" dev:DevToolsProportionalPanel.Weight="{Binding MeasureShare}" />
                            <Border Background="{DynamicResource DevTools.Warning}" dev:DevToolsProportionalPanel.Weight="{Binding ArrangeShare}" />
                            <Border Background="{DynamicResource DevTools.Error}" dev:DevToolsProportionalPanel.Weight="{Binding VisualShare}" />
                            <Border dev:DevToolsProportionalPanel.Weight="{Binding TrailingShare}" />
                        </dev:DevToolsProportionalPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMeasureHighlighted}" Value="True"><Setter TargetName="PART_MeasureLabel" Property="Foreground" Value="{DynamicResource DevTools.Info}" /><Setter TargetName="PART_MeasureLabel" Property="FontWeight" Value="SemiBold" /></DataTrigger>
            <DataTrigger Binding="{Binding IsArrangeHighlighted}" Value="True"><Setter TargetName="PART_ArrangeLabel" Property="Foreground" Value="{DynamicResource DevTools.Warning}" /><Setter TargetName="PART_ArrangeLabel" Property="FontWeight" Value="SemiBold" /></DataTrigger>
            <DataTrigger Binding="{Binding IsInvalidationHighlighted}" Value="True"><Setter TargetName="PART_InvalidationLabel" Property="Foreground" Value="{DynamicResource DevTools.Error}" /><Setter TargetName="PART_InvalidationLabel" Property="FontWeight" Value="SemiBold" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="DevTools.LayoutInvalidationTemplate">
        <Grid Margin="4,0,4,2">
            <Border Background="{DynamicResource DevTools.Chrome}" Padding="12,4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource DevTools.MonoText}" FontSize="10" Foreground="{DynamicResource DevTools.TextSecondary}" />
                    <dev:DevToolsTag Name="PART_Kind" Grid.Column="1" Text="{Binding Kind}" HorizontalAlignment="Left" Margin="0,0,8,0" TintOpacity="0.22" />
                    <TextBlock Grid.Column="2" Text="{Binding ElementName}" ToolTip="{Binding ElementName}" Style="{StaticResource DevTools.MonoText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SourceText}" ToolTip="{Binding SourceText}" Style="{StaticResource DevTools.MonoText}" FontSize="10" Foreground="{DynamicResource DevTools.TextSecondary}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
            <Border Name="PART_KindAccent" Width="2" HorizontalAlignment="Left" Background="{DynamicResource DevTools.TextMuted}" Opacity="0.38" IsHitTestVisible="False" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Measure"><Setter TargetName="PART_Kind" Property="Foreground" Value="{DynamicResource DevTools.Info}" /><Setter TargetName="PART_KindAccent" Property="Background" Value="{DynamicResource DevTools.Info}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Arrange"><Setter TargetName="PART_Kind" Property="Foreground" Value="{DynamicResource DevTools.Warning}" /><Setter TargetName="PART_KindAccent" Property="Background" Value="{DynamicResource DevTools.Warning}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Visual"><Setter TargetName="PART_Kind" Property="Foreground" Value="{DynamicResource DevTools.Error}" /><Setter TargetName="PART_KindAccent" Property="Background" Value="{DynamicResource DevTools.Error}" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <Style TargetType="dev:DevToolsLayoutProfiler">
        <Setter Property="Background" Value="{DynamicResource DevTools.Surface}" /><Setter Property="Foreground" Value="{DynamicResource DevTools.TextPrimary}" /><Setter Property="ClipToBounds" Value="True" />
        <Setter Property="StatsItemTemplate" Value="{StaticResource DevTools.LayoutStatsTemplate}" /><Setter Property="InvalidationItemTemplate" Value="{StaticResource DevTools.LayoutInvalidationTemplate}" />
        <Setter Property="Template"><ControlTemplate TargetType="dev:DevToolsLayoutProfiler">
            <Grid Background="{TemplateBinding Background}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="RecordingStates"><VisualState x:Name="Idle" /><VisualState x:Name="Recording"><VisualState.Setters>
                        <Setter TargetName="PART_RecordButton" Property="Label" Value="Stop recording" /><Setter TargetName="PART_RecordButton" Property="Icon" Value="■" />
                        <Setter TargetName="PART_RecordingTag" Property="Text" Value="REC" /><Setter TargetName="PART_RecordingTag" Property="Foreground" Value="{DynamicResource DevTools.Error}" />
                    </VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="StatsStates"><VisualState x:Name="StatsAvailable" /><VisualState x:Name="StatsEmpty"><VisualState.Setters><Setter TargetName="PART_StatsList" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_StatsEmpty" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="InvalidationStates"><VisualState x:Name="InvalidationsAvailable" /><VisualState x:Name="InvalidationsEmpty"><VisualState.Setters><Setter TargetName="PART_InvalidationList" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_InvalidationsEmpty" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="FooterStates"><VisualState x:Name="FooterEmpty" /><VisualState x:Name="FooterAvailable"><VisualState.Setters><Setter TargetName="PART_Footer" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="SortStates"><VisualState x:Name="MeasureSort" /><VisualState x:Name="ArrangeSort"><VisualState.Setters><Setter TargetName="PART_SortButton" Property="Label" Value="Sort: Arrange µs" /></VisualState.Setters></VisualState><VisualState x:Name="InvalidationsSort"><VisualState.Setters><Setter TargetName="PART_SortButton" Property="Label" Value="Sort: Invalidations" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.6" /></VisualState.Setters></VisualState></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <dev:DevToolsSurface Kind="Toolbar">
                    <WrapPanel>
                        <dev:DevToolsActionButton Name="PART_RecordButton" Label="Start recording" Icon="●" Variant="Primary" Command="{TemplateBinding ToggleRecordingCommand}" />
                        <dev:DevToolsActionButton Name="PART_ResetButton" Label="Reset" Icon="↺" Command="{TemplateBinding ResetCommand}" />
                        <dev:DevToolsActionButton Name="PART_StackButton" Label="Capture stacks" Icon="☰" IsActive="{TemplateBinding IsStackCaptureEnabled}" Command="{TemplateBinding ToggleStackCaptureCommand}" />
                        <Border Style="{StaticResource DevTools.VerticalDivider}" />
                        <dev:DevToolsActionButton Name="PART_SortButton" Label="Sort: Measure µs" Icon="⇅" Command="{TemplateBinding CycleSortCommand}" />
                        <dev:DevToolsTag Name="PART_RecordingTag" Text="IDLE" Margin="4,0" />
                    </WrapPanel>
                </dev:DevToolsSurface>
                <dev:DevToolsSurface Grid.Row="1" Kind="Panel" Heading="Top elements by layout cost" IndicatorBrush="{DynamicResource DevTools.Info}" Margin="8,8,8,4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="ELEMENT · MEASURE / ARRANGE / INVALIDATIONS" Style="{StaticResource DevTools.Eyebrow}" Margin="4,0,4,8" TextTrimming="CharacterEllipsis" />
                        <ListBox Name="PART_StatsList" Grid.Row="1" Style="{StaticResource DevTools.LayoutList}" ItemsSource="{TemplateBinding StatsSource}" ItemTemplate="{TemplateBinding StatsItemTemplate}" automation:AutomationProperties.Name="Layout cost ranking" />
                        <TextBlock Name="PART_StatsEmpty" Grid.Row="1" Text="No layout activity captured yet." Style="{StaticResource DevTools.MutedText}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="12" />
                        <TextBlock Name="PART_Footer" Grid.Row="2" Text="{TemplateBinding FooterText}" Style="{StaticResource DevTools.MutedText}" FontSize="10" Visibility="Collapsed" Margin="4,4,4,0" />
                    </Grid>
                </dev:DevToolsSurface>
                <dev:DevToolsSurface Grid.Row="2" Margin="8,4,8,8" Padding="12,8,12,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="INVALIDATION TIMELINE" Style="{StaticResource DevTools.Eyebrow}" />
                            <dev:DevToolsTag Name="PART_InvalidationCount" Grid.Column="1" Text="{Binding InvalidationCount, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource DevTools.Info}" />
                        </Grid>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource DevTools.BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,8,16,4">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="TIME" Style="{StaticResource DevTools.Eyebrow}" /><TextBlock Grid.Column="1" Text="KIND" Style="{StaticResource DevTools.Eyebrow}" /><TextBlock Grid.Column="2" Text="ELEMENT / SOURCE" Style="{StaticResource DevTools.Eyebrow}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ListBox Name="PART_InvalidationList" Grid.Row="2" Style="{StaticResource DevTools.LayoutList}" ItemsSource="{TemplateBinding InvalidationSource}" ItemTemplate="{TemplateBinding InvalidationItemTemplate}" automation:AutomationProperties.Name="Invalidation timeline" />
                        <TextBlock Name="PART_InvalidationsEmpty" Grid.Row="2" Text="No invalidations recorded." Style="{StaticResource DevTools.MutedText}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="12" />
                    </Grid>
                </dev:DevToolsSurface>
            </Grid>
        </ControlTemplate></Setter>
    </Style>
</ResourceDictionary>
