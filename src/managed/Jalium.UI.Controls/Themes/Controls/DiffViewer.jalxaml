<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- DiffViewer Style                                -->
    <!-- ============================================== -->
    <!-- Frame and minimap viewport are replaceable; DiffContentView renders document pixels. -->
    <Style TargetType="DiffViewer">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="100" />
        <Setter Property="Template">
            <ControlTemplate TargetType="DiffViewer">
                <Grid Name="Root">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates"><VisualState Name="Normal" /><VisualState Name="Disabled" /></VisualStateGroup>
                        <VisualStateGroup Name="FocusStates"><VisualState Name="Focused" /><VisualState Name="Unfocused" /></VisualStateGroup>
                        <VisualStateGroup Name="ViewStates"><VisualState Name="SideBySide" /><VisualState Name="Unified" /></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border Name="RootBorder" Shape="RoundedRectangle"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                    <Grid Clip="{TemplateBinding DiffContentClip}" IsHitTestVisible="False">
                        <Canvas>
                            <Border Name="PART_Minimap" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                                    Visibility="{TemplateBinding MinimapVisibility}"
                                    Canvas.Left="{Binding MinimapBounds.X, RelativeSource={RelativeSource TemplatedParent}}" Canvas.Top="{Binding MinimapBounds.Y, RelativeSource={RelativeSource TemplatedParent}}"
                                    Width="{Binding MinimapBounds.Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding MinimapBounds.Height, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Canvas>
                        <DiffContentView Name="PART_ContentView" Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        <Canvas>
                            <Border Name="PART_MinimapViewport" Opacity="0.3" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{TemplateBinding MinimapVisibility}"
                                    Canvas.Left="{Binding MinimapViewportBounds.X, RelativeSource={RelativeSource TemplatedParent}}" Canvas.Top="{Binding MinimapViewportBounds.Y, RelativeSource={RelativeSource TemplatedParent}}"
                                    Width="{Binding MinimapViewportBounds.Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding MinimapViewportBounds.Height, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Canvas>
                    </Grid>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="RootBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderHover}" />
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter TargetName="RootBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
