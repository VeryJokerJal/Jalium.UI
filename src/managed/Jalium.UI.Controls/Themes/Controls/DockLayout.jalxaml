<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Jalium.UI.Automation">

    <!-- DockLayout -->
    <Style TargetType="DockLayout">
        <Setter Property="Background" Value="{ThemeResource WindowBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DockTabStripBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="HighlightBrush" Value="{ThemeResource AccentBrush}" /><Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template"><ControlTemplate TargetType="DockLayout"><Grid>
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.56" /></VisualState.Setters></VisualState></VisualStateGroup><VisualStateGroup x:Name="DockStates"><VisualState x:Name="NotHighlighted" /><VisualState x:Name="Highlighted"><VisualState.Setters><Setter TargetName="PART_Highlight" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" /></Border>
            <Border x:Name="PART_Highlight" BorderBrush="{TemplateBinding HighlightBrush}" BorderThickness="2" Margin="1" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid></ControlTemplate></Setter>
    </Style>

    <!-- DockTabPanel -->
    <Style TargetType="DockTabPanel">
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="MinHeight" Value="100" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{ThemeResource DockContentBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="TabStripBackground" Value="{ThemeResource DockTabStripBackground}" />
        <Setter Property="TabStripBorderBrush" Value="{ThemeResource DockTabStripBorder}" />
        <Setter Property="TabStripHeight" Value="32" />
        <Setter Property="FontSize" Value="{ThemeResource CaptionFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DockTabPanel">
                    <Border x:Name="PART_Border" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PlacementStates">
                                <VisualState x:Name="Top" /><VisualState x:Name="Bottom" />
                                <VisualState x:Name="Left" /><VisualState x:Name="Right" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="OverflowStates">
                                <VisualState x:Name="Overflowing" /><VisualState x:Name="NotOverflowing" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Empty" /><VisualState x:Name="Selected" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <DockTabLayoutPanel x:Name="PART_Layout" ClipToBounds="True">
                            <DockTabChrome x:Name="PART_Background" IsHitTestVisible="False" />
                            <ItemsPresenter x:Name="PART_ItemsPresenter" />
                            <TransitioningContentControl x:Name="PART_SelectedContentHost"
                                Content="{TemplateBinding SelectedContent}" ClipToBounds="True"
                                TransitionMode="{TemplateBinding SelectedContentTransitionMode}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                            <ScrollBar x:Name="PART_TabStripScrollBar" Orientation="Horizontal"
                                Visibility="Collapsed" IsThumbSlim="True" SmallChange="32" LargeChange="120"
                                Focusable="False" IsTabStop="False" />
                            <DockTabChrome x:Name="PART_ChromeOverlay" IsOverlay="True" IsHitTestVisible="False" />
                        </DockTabLayoutPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DockItem -->
    <Style TargetType="DockItem">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="SelectedBackground" Value="{ThemeResource DockTabItemSelectedBackground}" />
        <Setter Property="HoverBackground" Value="{ThemeResource DockTabItemHoverBackground}" />
        <Setter Property="IndicatorBrush" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Padding" Value="12,7,12,7" />
        <Setter Property="Template"><ControlTemplate TargetType="DockItem"><Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Disabled" /></VisualStateGroup>
                <VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Selected" /><VisualState x:Name="Unselected" /></VisualStateGroup>
                <VisualStateGroup x:Name="BackgroundStates"><VisualState x:Name="IdleBackground" /><VisualState x:Name="PointerBackground"><VisualState.Setters><Setter TargetName="PART_Background" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource TemplatedParent}}" /></VisualState.Setters></VisualState><VisualState x:Name="SelectedBackground"><VisualState.Setters><Setter TargetName="PART_Background" Property="Background" Value="{Binding SelectedBackground, RelativeSource={RelativeSource TemplatedParent}}" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="CloseStates"><VisualState x:Name="CloseVisible" /><VisualState x:Name="CloseHidden"><VisualState.Setters><Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden" /></VisualState.Setters></VisualState><VisualState x:Name="NotClosable"><VisualState.Setters><Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="HeaderStates"><VisualState x:Name="TextHeader" /><VisualState x:Name="CustomHeader"><VisualState.Setters><Setter TargetName="PART_HeaderText" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_Header" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="PlacementStates"><VisualState x:Name="Top" /><VisualState x:Name="Bottom"><VisualState.Setters><Setter TargetName="PART_Background" Property="Margin" Value="0,-1,0,0" /></VisualState.Setters></VisualState><VisualState x:Name="Left"><VisualState.Setters><Setter TargetName="PART_Background" Property="Margin" Value="0,0,-1,0" /></VisualState.Setters></VisualState><VisualState x:Name="Right"><VisualState.Setters><Setter TargetName="PART_Background" Property="Margin" Value="-1,0,0,0" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="DragStates"><VisualState x:Name="NotReordering" /><VisualState x:Name="Reordering"><VisualState.Setters><Setter TargetName="PART_DragOverlay" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="PART_Background" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding ChromeCornerRadius}" Margin="0,0,0,-1" />
            <Border Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid ClipToBounds="True" VerticalAlignment="Center"><TextBlock x:Name="PART_HeaderText" Text="{TemplateBinding Header}" TextTrimming="CharacterEllipsis" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" /><ContentPresenter x:Name="PART_Header" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" ContentStringFormat="{TemplateBinding HeaderStringFormat}" Visibility="Collapsed" /></Grid>
                <Button x:Name="PART_CloseButton" Grid.Column="1" Style="{TemplateBinding CloseButtonStyle}" Width="18" Height="18" MinWidth="18" MinHeight="18" Margin="2,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" automation:AutomationProperties.Name="关闭标签页"><Path Width="8" Height="8" Data="M0,0 L8,8 M8,0 L0,8" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" IsHitTestVisible="False" /></Button>
            </Grid></Border>
            <Border x:Name="PART_DragOverlay" BorderBrush="{TemplateBinding IndicatorBrush}" BorderThickness="1" Background="{ThemeResource HighlightBackground}" CornerRadius="{TemplateBinding ChromeCornerRadius}" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid></ControlTemplate></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{ThemeResource TextPrimary}" /></Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
                <Setter Property="Opacity" Value="0.56" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dock indicators -->
    <SolidColorBrush x:Key="DockIndicatorChromeBackground" Color="{ThemeResource LayerOnAcrylicFillColorDefault}" />
    <SolidColorBrush x:Key="DockIndicatorChromeBorder" Color="{ThemeResource SurfaceStrokeColorFlyout}" />
    <SolidColorBrush x:Key="DockIndicatorButtonBackground" Color="{ThemeResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="DockIndicatorButtonBorder" Color="{ThemeResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="DockIndicatorButtonHoverBackground" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="DockIndicatorIconForeground" Color="{ThemeResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DockIndicatorIconHoverForeground" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
    <SolidColorBrush x:Key="DockIndicatorPreviewBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.20" />
    <SolidColorBrush x:Key="DockIndicatorPreviewBorder" Color="{ThemeResource SystemAccentColor}" Opacity="0.68" />

    <Style x:Key="DockIndicator.TargetContainer" TargetType="ContentPresenter">
        <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" /><Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
        <Setter Property="Width" Value="{Binding Bounds.Width}" /><Setter Property="Height" Value="{Binding Bounds.Height}" />
        <Setter Property="Visibility" Value="{Binding Visibility}" />
    </Style>
    <DataTemplate x:Key="DockIndicator.TargetTemplate">
        <Grid>
            <Border Background="{Binding ChromeBackground, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" BorderBrush="{Binding ChromeBorderBrush, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" BorderThickness="1" CornerRadius="6" Margin="-4" Visibility="{Binding EdgePlateVisibility}" />
            <Border Name="TargetBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" BorderThickness="1" CornerRadius="6" Padding="6">
                <Grid Width="18" Height="18">
                    <Border Name="IconOutline" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" BorderThickness="1.2" CornerRadius="1.5" />
                    <Canvas>
                        <Rectangle Name="IconFill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" Opacity="0.55"
                                   Canvas.Left="{Binding IconRegion.X}" Canvas.Top="{Binding IconRegion.Y}" Width="{Binding IconRegion.Width}" Height="{Binding IconRegion.Height}" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
        <DataTemplate.Triggers><DataTrigger Binding="{Binding IsHovered}" Value="True">
            <Setter TargetName="TargetBorder" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" />
            <Setter TargetName="TargetBorder" Property="BorderBrush" Value="{Binding HoverBackground, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" />
            <Setter TargetName="IconOutline" Property="BorderBrush" Value="{Binding HoverForeground, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" />
            <Setter TargetName="IconFill" Property="Fill" Value="{Binding HoverForeground, RelativeSource={RelativeSource AncestorType=DockIndicatorVisual}}" />
        </DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <Style TargetType="DockIndicatorVisual">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="HoverBackground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="HoverForeground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="ChromeBackground" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="ChromeBorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="TargetTemplate" Value="{StaticResource DockIndicator.TargetTemplate}" />
        <Setter Property="TargetContainerStyle" Value="{StaticResource DockIndicator.TargetContainer}" />
        <Setter Property="Template"><ControlTemplate TargetType="DockIndicatorVisual">
            <Grid Name="Root" ClipToBounds="True">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates"><VisualState Name="Normal" /><VisualState Name="Disabled" /></VisualStateGroup>
                    <VisualStateGroup Name="HoverStates"><VisualState Name="Idle" /><VisualState Name="TargetHovered" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Canvas>
                    <Border Name="PART_Preview" BorderBrush="{TemplateBinding HoverBackground}" BorderThickness="1" CornerRadius="4" Opacity="0.68" Visibility="{TemplateBinding PreviewVisibility}"
                            Canvas.Left="{Binding PreviewBounds.X, RelativeSource={RelativeSource TemplatedParent}}" Canvas.Top="{Binding PreviewBounds.Y, RelativeSource={RelativeSource TemplatedParent}}" Width="{Binding PreviewBounds.Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding PreviewBounds.Height, RelativeSource={RelativeSource TemplatedParent}}"><Border Background="{TemplateBinding HoverBackground}" Opacity="0.3" CornerRadius="3" /></Border>
                    <Border Background="{TemplateBinding ChromeBackground}" BorderBrush="{TemplateBinding ChromeBorderBrush}" BorderThickness="1" CornerRadius="6" Visibility="{TemplateBinding CrossVisibility}"
                            Canvas.Left="{Binding HorizontalCrossBounds.X, RelativeSource={RelativeSource TemplatedParent}}" Canvas.Top="{Binding HorizontalCrossBounds.Y, RelativeSource={RelativeSource TemplatedParent}}" Width="{Binding HorizontalCrossBounds.Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding HorizontalCrossBounds.Height, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border Background="{TemplateBinding ChromeBackground}" BorderBrush="{TemplateBinding ChromeBorderBrush}" BorderThickness="1" CornerRadius="6" Visibility="{TemplateBinding CrossVisibility}"
                            Canvas.Left="{Binding VerticalCrossBounds.X, RelativeSource={RelativeSource TemplatedParent}}" Canvas.Top="{Binding VerticalCrossBounds.Y, RelativeSource={RelativeSource TemplatedParent}}" Width="{Binding VerticalCrossBounds.Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding VerticalCrossBounds.Height, RelativeSource={RelativeSource TemplatedParent}}" />
                </Canvas>
                <ItemsControl Name="PART_Targets" ItemsSource="{TemplateBinding Targets}" ItemTemplate="{TemplateBinding TargetTemplate}" ItemContainerStyle="{TemplateBinding TargetContainerStyle}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.65" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter>
    </Style>

    <!-- Split (internal) -->
    <Style TargetType="Split">
        <Setter Property="Background" Value="{ThemeResource DockSplitterBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="HoverBrush" Value="{ThemeResource DockSplitterHover}" />
        <Setter Property="DraggingBrush" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Split"><Border x:Name="PART_Chrome" Background="{TemplateBinding Background}">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="Background" Value="{Binding HoverBrush, RelativeSource={RelativeSource TemplatedParent}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="Background" Value="{Binding DraggingBrush, RelativeSource={RelativeSource TemplatedParent}}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateManager.VisualStateGroups>
        </Border></ControlTemplate></Setter.Value></Setter>
    </Style>

</ResourceDictionary>
