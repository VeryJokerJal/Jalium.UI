<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="MediaElement">
        <Setter Property="Background" Value="Black" />
        <Setter Property="Foreground" Value="#FFC8C8C8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><ControlTemplate TargetType="MediaElement">
            <Grid Name="PART_Root" ClipToBounds="True">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates"><VisualState Name="Normal" /><VisualState Name="Disabled"><VisualState.Setters><Setter TargetName="PART_Root" Property="Opacity" Value="0.65" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup Name="ContentStates"><VisualState Name="Empty" /><VisualState Name="Loading" /><VisualState Name="AudioOnly" /><VisualState Name="Video" /></VisualStateGroup>
                    <VisualStateGroup Name="PlaybackStates"><VisualState Name="Stopped" /><VisualState Name="Playing" /><VisualState Name="Paused" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                <Grid Clip="{TemplateBinding MediaContentClip}">
                <MediaVideoSurface Name="PART_VideoSurface" Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                <TextBlock Name="PART_Status" Text="{TemplateBinding DisplayStatusText}" Visibility="{TemplateBinding DisplayStatusVisibility}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="12" />
                <Border Name="PART_SubtitleFrame" Background="{TemplateBinding SubtitleBackground}" Visibility="{TemplateBinding SubtitleVisibility}" Padding="8,6" Margin="24,8,24,26" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False">
                    <TextBlock Name="PART_Subtitle" Text="{TemplateBinding CurrentSubtitle}" Foreground="{TemplateBinding SubtitleForeground}" FontSize="{TemplateBinding SubtitleFontSize}" LineHeight="{TemplateBinding ComputedSubtitleLineHeight}" MaxWidth="{TemplateBinding ComputedSubtitleMaxWidth}" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
                </Grid>
            </Grid>
        </ControlTemplate></Setter>
    </Style>

    <!-- ============================================== -->
    <!-- Image Style                                     -->
    <!-- ============================================== -->
    <Style TargetType="Image">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================== -->
    <!-- QRCode Style                                    -->
    <!-- ============================================== -->
    <Style TargetType="QRCode">
        <Setter Property="Background" Value="{ThemeResource QRCodeBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource QRCodeForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template"><ControlTemplate TargetType="QRCode">
            <Grid Name="PART_Root">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates"><VisualState Name="Normal" /><VisualState Name="Disabled"><VisualState.Setters><Setter TargetName="PART_Root" Property="Opacity" Value="0.65" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup Name="ContentStates"><VisualState Name="Empty" /><VisualState Name="Ready" /><VisualState Name="Error" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                <Grid Clip="{TemplateBinding SymbolClip}"><QRCodeView Name="PART_SymbolView" Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}" /></Grid>
            </Grid>
        </ControlTemplate></Setter>
    </Style>

</ResourceDictionary>
