<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="MessageBoxResponseStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="16,6" />
    </Style>
    <Style TargetType="MessageBoxDialog">
        <Setter Property="Background" Value="{ThemeResource WindowBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="MessageBoxDialog">
                <StackPanel x:Name="PART_MessageBoxRoot" Margin="20">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="ResponseStates">
                            <VisualState x:Name="OkOnly"><VisualState.Setters>
                                <Setter TargetName="PART_OkButton" Property="Visibility" Value="Visible" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="OkCancel"><VisualState.Setters>
                                <Setter TargetName="PART_OkButton" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_CancelButton" Property="Visibility" Value="Visible" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="YesNo"><VisualState.Setters>
                                <Setter TargetName="PART_YesButton" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_NoButton" Property="Visibility" Value="Visible" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="YesNoCancel"><VisualState.Setters>
                                <Setter TargetName="PART_YesButton" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_NoButton" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_CancelButton" Property="Visibility" Value="Visible" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="IconStates">
                            <VisualState x:Name="WithIcon" />
                            <VisualState x:Name="WithoutIcon"><VisualState.Setters>
                                <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PART_Icon" Text="{TemplateBinding IconText}" FontSize="32" VerticalAlignment="Top" Margin="0,0,16,0" />
                        <ScrollViewer x:Name="PART_MessageScrollViewer" Grid.Column="1" MaxHeight="{TemplateBinding MaxMessageHeight}"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <TextBlock Text="{TemplateBinding MessageText}" TextWrapping="Wrap" VerticalAlignment="Top"
                                       TextAlignment="{TemplateBinding MessageAlignment}" FlowDirection="{TemplateBinding MessageFlowDirection}" />
                        </ScrollViewer>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PART_OkButton" Content="OK" Style="{StaticResource MessageBoxResponseStyle}" Visibility="Collapsed" />
                        <Button x:Name="PART_YesButton" Content="Yes" Style="{StaticResource MessageBoxResponseStyle}" Visibility="Collapsed" />
                        <Button x:Name="PART_NoButton" Content="No" Style="{StaticResource MessageBoxResponseStyle}" Visibility="Collapsed" />
                        <Button x:Name="PART_CancelButton" Content="Cancel" Style="{StaticResource MessageBoxResponseStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
