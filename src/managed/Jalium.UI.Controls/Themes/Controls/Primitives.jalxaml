<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- Default Focus Visual Style                     -->
    <!-- Applied by FocusVisualManager to the adorner   -->
    <!-- layer whenever an element gains keyboard focus.-->
    <!-- Targets Control because FocusVisualHost is a   -->
    <!-- Control subclass; CornerRadius is mirrored from-->
    <!-- the adorned element by the manager.            -->
    <!-- The stroke brush and thickness are Setters on  -->
    <!-- the host and the template only TemplateBinds   -->
    <!-- them, so a derived style                       -->
    <!--   <Style BasedOn="{StaticResource              -->
    <!--          DefaultFocusVisualStyle}"             -->
    <!--          TargetType="Control">                 -->
    <!--     <Setter Property="BorderBrush" .../>       -->
    <!--     <Setter Property="BorderThickness" .../>   -->
    <!--   </Style>                                     -->
    <!-- recolors / re-weights the ring without         -->
    <!-- redeclaring the template. Hard-coding them in  -->
    <!-- the template made such setters silently no-op -->
    <!-- and left the theme ring in place.              -->
    <!-- ============================================== -->
    <Style x:Key="DefaultFocusVisualStyle" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="BorderBrush" Value="{ThemeResource FocusStrokeColorOuterBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Control">
                <Grid>
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Shape="RoundedRectangle"
                            IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- ToolBarPanel Style -->
    <!-- ============================================== -->
    <Style TargetType="ToolBarPanel">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================================== -->
    <!-- ToolBarOverflowPanel Style -->
    <!-- ============================================== -->
    <Style TargetType="ToolBarOverflowPanel">
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="WrapWidth" Value="240" />
    </Style>

    <!-- ============================================== -->
    <!-- UniformGrid Style -->
    <!-- ============================================== -->
    <Style TargetType="UniformGrid">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================================== -->
    <!-- SelectiveScrollingGrid Style -->
    <!-- ============================================== -->
    <Style TargetType="SelectiveScrollingGrid">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================================== -->
    <!-- StatusBarItem Style -->
    <!-- ============================================== -->
    <Style TargetType="StatusBarItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="Padding" Value="10,3,10,3" />
        <Setter Property="FontSize" Value="{ThemeResource CaptionFontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <ControlTemplate TargetType="StatusBarItem">
                <Border x:Name="StatusBarItemRoot" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"><VisualState.Setters><Setter TargetName="StatusBarItemRoot" Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter TargetName="StatusBarItemRoot" Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="SeparatorStates"><VisualState x:Name="SeparatorVisible" /><VisualState x:Name="SeparatorCollapsed" /></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                          TextElement.FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                          TextElement.FontFamily="{Binding FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                          TextElement.FontWeight="{Binding FontWeight, RelativeSource={RelativeSource TemplatedParent}}"
                                          TextElement.FontStyle="{Binding FontStyle, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid Grid.Column="1" Width="9" Visibility="{TemplateBinding SeparatorVisibility}">
                            <Border Width="1" Background="{ThemeResource ControlBorder}" Margin="4,1" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- DocumentPageView Style -->
    <!-- ============================================== -->
    <Style TargetType="DocumentPageView">
        <Setter Property="Background" Value="{ThemeResource WindowBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ============================================== -->
    <!-- ResizeGrip Style -->
    <!-- ============================================== -->
    <Style TargetType="ResizeGrip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template"><ControlTemplate TargetType="ResizeGrip">
            <Grid Name="Root" Background="{TemplateBinding Background}">
                <VisualStateManager.VisualStateGroups><VisualStateGroup Name="CommonStates"><VisualState Name="Normal" /><VisualState Name="Disabled" /></VisualStateGroup></VisualStateManager.VisualStateGroups>
                <Path Name="PART_Grip" Data="M3,12 L12,3 M6,12 L12,6 M9,12 L12,9" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.65" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter>
    </Style>

    <!-- ============================================== -->
    <!-- Separator Style -->
    <!-- ============================================== -->
    <Style TargetType="Separator">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="StrokeBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Margin" Value="0,6,0,6" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Separator">
                <Border x:Name="SeparatorRoot" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled" />
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="OrientationStates">
                            <VisualState x:Name="Horizontal">
                                <VisualState.Setters>
                                    <Setter TargetName="PART_HorizontalLine" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="PART_VerticalLine" Property="Visibility" Value="Collapsed" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Vertical">
                                <VisualState.Setters>
                                    <Setter TargetName="PART_HorizontalLine" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="PART_VerticalLine" Property="Visibility" Value="Visible" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid>
                        <Border x:Name="PART_HorizontalLine" Height="{TemplateBinding StrokeThickness}"
                                VerticalAlignment="Center" Background="{TemplateBinding ResolvedStrokeBrush}" />
                        <Border x:Name="PART_VerticalLine" Width="{TemplateBinding StrokeThickness}"
                                HorizontalAlignment="Center" Visibility="Collapsed"
                                Background="{TemplateBinding ResolvedStrokeBrush}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Margin" Value="6,0,6,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="{x:Static StatusBar.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Margin" Value="4,2" />
    </Style>

    <!-- ============================================== -->
    <!-- Label Style -->
    <!-- ============================================== -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Label">
                <Border Name="LabelBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- ToolTip Style -->
    <!-- ============================================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{ThemeResource TooltipBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="{ThemeResource CaptionFontSize}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToolTip">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Shape="RoundedRectangle"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

</ResourceDictionary>
