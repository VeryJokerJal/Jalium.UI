<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PropertyGridErrorForegroundBrush" Color="#FFB4AB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PropertyGridErrorForegroundBrush" Color="#B3261E" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PropertyGridErrorForegroundBrush" Color="#FFFF00" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ============================================== -->
    <!-- PropertyGrid Segmented Toolbar Button           -->
    <!-- ============================================== -->
    <!-- 分段按钮使用主题强调色，并保留键盘焦点边框 -->
    <Style x:Key="PropertyGridToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Grid>
                    <Border Name="RootBorder"
                            Shape="RoundedRectangle"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" />
                    <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="RootBorder" Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="RootBorder" Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="RootBorder" Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 激活状态使用主题强调色与对应前景色 -->
    <Style x:Key="PropertyGridToolbarButtonActiveStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Grid>
                    <Border Name="RootBorder"
                            Shape="RoundedRectangle"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" />
                    <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="RootBorder" Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="RootBorder" Property="Background" Value="{ThemeResource AccentBrushHover}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="RootBorder" Property="Background" Value="{ThemeResource AccentBrushPressed}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- PropertyGrid Search Box Style                   -->
    <!-- ============================================== -->
    <!-- 搜索框使用主题输入色与焦点边框 -->
    <Style x:Key="PropertyGridSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="28,6,10,6" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="SelectionBrush" Value="{ThemeResource SelectionBackground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorInputActiveBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- PropertyGrid Category Expander Style            -->
    <!-- ============================================== -->
    <!-- 分类头使用强调色、展开标记与悬停反馈 -->
    <Style x:Key="PropertyGridCategoryExpanderStyle" TargetType="Expander">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HeaderBackground" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Expander">
                <Grid Name="RootBorder"
                      Background="{TemplateBinding Background}"
                      ClipToBounds="True">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Name="PART_HeaderBorder"
                                  Background="{TemplateBinding HeaderBackground}">
                                <Grid Margin="10,6,10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Chevron: 右三角=折叠, 下三角=展开 -->
                                    <Path Name="PART_Chevron"
                                          Grid.Column="0"
                                          Data="M333.414 23.989 l557.904 393.923 c58.785 42.21 58.785 147.737 0 189.948 l-557.904 395.106 c-58.785 42.21-155.948 11.943-155.948-72.478 v-835.205 c0-84.421 97.162-113.505 155.948-71.293 Z"
                                          Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                          Width="7"
                                          Height="9"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="2,0,8,0" />

                                    <!-- 紫色竖条 -->
                                    <Rectangle Grid.Column="1"
                                               Width="3"
                                               Height="12"
                                               Fill="{ThemeResource AccentBrush}"
                                               RadiusX="2"
                                               RadiusY="2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />

                                    <!-- Header Content: 显式 Stretch 以填满 * 列,覆盖 ContentPresenter 默认从 Expander.HorizontalContentAlignment(Left)继承的绑定 -->
                                    <ContentPresenter Name="PART_HeaderContent"
                                                      Grid.Column="2"
                                                      Content="{TemplateBinding Header}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <!-- Content -->
                            <Grid Name="PART_ContentBorder"
                                  Visibility="Collapsed">
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </StackPanel>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_HeaderBorder" Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- PropertyGrid Editor: TextBox (inline, no border)-->
    <!-- ============================================== -->
    <!-- 内嵌式 TextBox: 默认无背景无边框, 悬停/聚焦时显示 -->
    <Style x:Key="PropertyGridEditorTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorTransparentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3,6,3" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="SelectionBrush" Value="{ThemeResource SelectionBackground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorInputActiveBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlFillColorTransparentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ============================================== -->
    <!-- PropertyGrid Style                              -->
    <!-- ============================================== -->

    <DataTemplate x:Key="PropertyGrid.PropertyTemplate">
        <PropertyGridRow Property="{Binding}"
            Owner="{Binding RelativeSource={RelativeSource AncestorType=PropertyGrid}}"
            SelectedProperty="{Binding SelectedProperty, RelativeSource={RelativeSource AncestorType=PropertyGrid}}"
            NameColumnWidth="{Binding NameColumnWidth, RelativeSource={RelativeSource AncestorType=PropertyGrid}}"
            NameForeground="{Binding PropertyNameForeground, RelativeSource={RelativeSource AncestorType=PropertyGrid}}" />
    </DataTemplate>
    <DataTemplate x:Key="PropertyGrid.CategoryTemplate">
        <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  HeaderBackground="{Binding CategoryHeaderBackground, RelativeSource={RelativeSource AncestorType=PropertyGrid}}"
                  Foreground="{Binding CategoryHeaderForeground, RelativeSource={RelativeSource AncestorType=PropertyGrid}}"
                  Style="{StaticResource PropertyGridCategoryExpanderStyle}">
            <ItemsControl ItemsSource="{Binding Properties}" ItemTemplate="{Binding PropertyTemplate, RelativeSource={RelativeSource AncestorType=PropertyGrid}}" />
        </Expander>
    </DataTemplate>

    <Style TargetType="PropertyGridRow">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><ControlTemplate TargetType="PropertyGridRow">
            <Border x:Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter TargetName="PART_Root" Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter TargetName="PART_Root" Property="Opacity" Value="0.55" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="SelectionStates">
                        <VisualState x:Name="Unselected"><VisualState.Setters><Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Selected"><VisualState.Setters><Setter TargetName="PART_Root" Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Unfocused" />
                        <VisualState x:Name="Focused"><VisualState.Setters><Setter TargetName="PART_Root" Property="BorderBrush" Value="{ThemeResource AccentBrush}" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact"><VisualState.Setters>
                            <Setter TargetName="PART_NameContainer" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="PART_Editor" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_Editor" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PART_Editor" Property="Grid.ColumnSpan" Value="2" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Rectangle x:Name="PART_SelectionIndicator" Grid.Column="0" Grid.RowSpan="2" Width="2" Margin="0,3,3,3" Fill="{ThemeResource AccentBrush}" RadiusX="1" RadiusY="1" />
                    <Grid x:Name="PART_NameContainer" Grid.Column="1" Width="{TemplateBinding EffectiveNameColumnWidth}">
                        <TextBlock x:Name="PART_Name" Text="{TemplateBinding DisplayName}" ToolTip="{TemplateBinding Description}" Foreground="{TemplateBinding NameForeground}"
                                   Margin="6,5,8,5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                    </Grid>
                    <PropertyGridEditor x:Name="PART_Editor" Grid.Column="2" Property="{TemplateBinding Property}" Owner="{TemplateBinding Owner}" />
                </Grid>
            </Border>
        </ControlTemplate></Setter>
    </Style>
    <ControlTemplate x:Key="PropertyGrid.Editor.Text" TargetType="PropertyGridEditor">
        <Grid x:Name="PART_Root">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="EditingStates"><VisualState x:Name="Display" /><VisualState x:Name="Editing" /></VisualStateGroup>
                    <VisualStateGroup x:Name="ValidationStates">
                        <VisualState x:Name="Valid"><VisualState.Setters><Setter TargetName="PART_ValidationMessage" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Invalid" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="ReadOnlyStates"><VisualState x:Name="Editable" /><VisualState x:Name="ReadOnly" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBox x:Name="PART_TextBox" Style="{StaticResource PropertyGridEditorTextBoxStyle}" IsReadOnly="{TemplateBinding EffectiveIsReadOnly}"
                         Text="{Binding EditText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         automation:AutomationProperties.Name="{TemplateBinding DisplayName}" automation:AutomationProperties.HelpText="{TemplateBinding ErrorText}" />
            <TextBlock x:Name="PART_ValidationMessage" Grid.Row="1" Text="{TemplateBinding ErrorText}" TextWrapping="Wrap" Foreground="{ThemeResource PropertyGridErrorForegroundBrush}" FontSize="11" Margin="0,2,0,4" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="PropertyGrid.Editor.Boolean" TargetType="PropertyGridEditor">
        <Grid x:Name="PART_Root">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="EditingStates"><VisualState x:Name="Display" /><VisualState x:Name="Editing" /></VisualStateGroup>
                    <VisualStateGroup x:Name="ValidationStates">
                        <VisualState x:Name="Valid"><VisualState.Setters><Setter TargetName="PART_ValidationMessage" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Invalid" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="ReadOnlyStates"><VisualState x:Name="Editable" /><VisualState x:Name="ReadOnly" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <CheckBox x:Name="PART_ValueControl" IsThreeState="{TemplateBinding IsNullable}" IsEnabled="{TemplateBinding CanEdit}" HorizontalAlignment="Left" VerticalAlignment="Center"
                          IsChecked="{Binding BooleanValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          automation:AutomationProperties.Name="{TemplateBinding DisplayName}" />
            <TextBlock x:Name="PART_ValidationMessage" Grid.Row="1" Text="{TemplateBinding ErrorText}" TextWrapping="Wrap" Foreground="{ThemeResource PropertyGridErrorForegroundBrush}" FontSize="11" Margin="0,2,0,4" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="PropertyGrid.Editor.Enum" TargetType="PropertyGridEditor">
        <Grid x:Name="PART_Root">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="EditingStates"><VisualState x:Name="Display" /><VisualState x:Name="Editing" /></VisualStateGroup>
                    <VisualStateGroup x:Name="ValidationStates">
                        <VisualState x:Name="Valid"><VisualState.Setters><Setter TargetName="PART_ValidationMessage" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Invalid" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="ReadOnlyStates"><VisualState x:Name="Editable" /><VisualState x:Name="ReadOnly" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ComboBox x:Name="PART_ValueControl" ItemsSource="{TemplateBinding EnumOptions}" IsEnabled="{TemplateBinding CanEdit}" MinHeight="24" FontSize="12" Padding="8,2,4,2"
                          SelectedItem="{Binding SelectedEnumOption, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          automation:AutomationProperties.Name="{TemplateBinding DisplayName}" />
            <TextBlock x:Name="PART_ValidationMessage" Grid.Row="1" Text="{TemplateBinding ErrorText}" TextWrapping="Wrap" Foreground="{ThemeResource PropertyGridErrorForegroundBrush}" FontSize="11" Margin="0,2,0,4" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="PropertyGrid.Editor.Color" TargetType="PropertyGridEditor">
        <Grid x:Name="PART_Root">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="EditingStates"><VisualState x:Name="Display" /><VisualState x:Name="Editing" /></VisualStateGroup>
                    <VisualStateGroup x:Name="ValidationStates">
                        <VisualState x:Name="Valid"><VisualState.Setters><Setter TargetName="PART_ValidationMessage" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Invalid" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="ReadOnlyStates"><VisualState x:Name="Editable" /><VisualState x:Name="ReadOnly" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ColorPicker x:Name="PART_ValueControl" IsCompact="True" IsEnabled="{TemplateBinding CanEdit}" HorizontalAlignment="Left"
                             Color="{Binding ColorValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                             automation:AutomationProperties.Name="{TemplateBinding DisplayName}" />
            <TextBlock x:Name="PART_ValidationMessage" Grid.Row="1" Text="{TemplateBinding ErrorText}" TextWrapping="Wrap" Foreground="{ThemeResource PropertyGridErrorForegroundBrush}" FontSize="11" Margin="0,2,0,4" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="PropertyGrid.Editor.Expandable" TargetType="PropertyGridEditor">
        <Grid x:Name="PART_Root">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="EditingStates"><VisualState x:Name="Display" /><VisualState x:Name="Editing" /></VisualStateGroup>
                    <VisualStateGroup x:Name="ValidationStates">
                        <VisualState x:Name="Valid"><VisualState.Setters><Setter TargetName="PART_ValidationMessage" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Invalid" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="ReadOnlyStates"><VisualState x:Name="Editable" /><VisualState x:Name="ReadOnly" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Expander x:Name="PART_Expander" Header="{TemplateBinding ValueText}"
                          IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          automation:AutomationProperties.Name="{TemplateBinding DisplayName}">
                    <ItemsControl ItemsSource="{TemplateBinding SubProperties}" ItemTemplate="{Binding PropertyTemplate, RelativeSource={RelativeSource AncestorType=PropertyGrid}}" />
                </Expander>
            <TextBlock x:Name="PART_ValidationMessage" Grid.Row="1" Text="{TemplateBinding ErrorText}" TextWrapping="Wrap" Foreground="{ThemeResource PropertyGridErrorForegroundBrush}" FontSize="11" Margin="0,2,0,4" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="PropertyGrid.Editor.Custom" TargetType="PropertyGridEditor">
        <Grid x:Name="PART_Root">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="EditingStates"><VisualState x:Name="Display" /><VisualState x:Name="Editing" /></VisualStateGroup>
                    <VisualStateGroup x:Name="ValidationStates">
                        <VisualState x:Name="Valid"><VisualState.Setters><Setter TargetName="PART_ValidationMessage" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Invalid" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="ReadOnlyStates"><VisualState x:Name="Editable" /><VisualState x:Name="ReadOnly" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ContentPresenter x:Name="PART_CustomContent" Content="{TemplateBinding CustomContent}" ContentTemplate="{TemplateBinding CustomTemplate}" IsEnabled="{TemplateBinding CanEdit}" />
            <TextBlock x:Name="PART_ValidationMessage" Grid.Row="1" Text="{TemplateBinding ErrorText}" TextWrapping="Wrap" Foreground="{ThemeResource PropertyGridErrorForegroundBrush}" FontSize="11" Margin="0,2,0,4" />
        </Grid>
    </ControlTemplate>
    <Style TargetType="PropertyGridEditor">
        <Setter Property="Margin" Value="4,3,8,3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource PropertyGrid.Editor.Text}" />
        <Style.Triggers>
            <Trigger Property="EditorKind" Value="Boolean"><Setter Property="Template" Value="{StaticResource PropertyGrid.Editor.Boolean}" /></Trigger>
            <Trigger Property="EditorKind" Value="Enum"><Setter Property="Template" Value="{StaticResource PropertyGrid.Editor.Enum}" /></Trigger>
            <Trigger Property="EditorKind" Value="Color"><Setter Property="Template" Value="{StaticResource PropertyGrid.Editor.Color}" /></Trigger>
            <Trigger Property="EditorKind" Value="Expandable"><Setter Property="Template" Value="{StaticResource PropertyGrid.Editor.Expandable}" /></Trigger>
            <Trigger Property="EditorKind" Value="Custom"><Setter Property="Template" Value="{StaticResource PropertyGrid.Editor.Custom}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PropertyGrid">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="200" />
        <Setter Property="PropertyNameForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CategoryHeaderForeground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="CategoryHeaderBackground" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="PropertyTemplate" Value="{StaticResource PropertyGrid.PropertyTemplate}" />
        <Setter Property="CategoryTemplate" Value="{StaticResource PropertyGrid.CategoryTemplate}" />
        <Setter Property="Template"><ControlTemplate TargetType="PropertyGrid">
            <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="SortStates">
                        <VisualState x:Name="Categorized"><VisualState.Setters><Setter TargetName="PART_CategorizedButton" Property="Style" Value="{StaticResource PropertyGridToolbarButtonActiveStyle}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Alphabetical"><VisualState.Setters><Setter TargetName="PART_AlphabeticalButton" Property="Style" Value="{StaticResource PropertyGridToolbarButtonActiveStyle}" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="ToolbarStates">
                        <VisualState x:Name="ToolbarVisible" />
                        <VisualState x:Name="ToolbarHidden"><VisualState.Setters><Setter TargetName="PART_ToolBar" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="SearchStates">
                        <VisualState x:Name="SearchVisible" />
                        <VisualState x:Name="SearchHidden"><VisualState.Setters><Setter TargetName="PART_SearchBox" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="DescriptionStates">
                        <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.15" /></VisualStateGroup.Transitions>
                        <VisualState x:Name="DescriptionVisible" />
                        <VisualState x:Name="DescriptionHidden"><VisualState.Setters><Setter TargetName="PART_DescriptionArea" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="DataStates">
                        <VisualState x:Name="Ready"><VisualState.Setters><Setter TargetName="PART_EmptyMessage" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Empty" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter TargetName="PART_Root" Property="Opacity" Value="0.65" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel x:Name="PART_ToolBar" Margin="6" Background="{ThemeResource LayerFillColorAltBrush}">
                        <Button x:Name="PART_CategorizedButton" Content="Categorized" Style="{StaticResource PropertyGridToolbarButtonStyle}" Margin="0,0,4,2" />
                        <Button x:Name="PART_AlphabeticalButton" Content="Alphabetical" Style="{StaticResource PropertyGridToolbarButtonStyle}" Margin="0,0,0,2" />
                    </WrapPanel>
                    <Grid x:Name="PART_SearchBox" Grid.Row="1" Margin="8,2,8,6">
                        <TextBox x:Name="PART_SearchTextBox" PlaceholderText="Search properties..." Style="{StaticResource PropertyGridSearchBoxStyle}"
                                 Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Search properties" />
                        <Path Data="M10 2a8 8 0 015.29 13.97l4.37 4.37-1.42 1.42-4.37-4.37A8 8 0 1110 2zm0 2a6 6 0 100 12 6 6 0 000-12z"
                              Fill="{ThemeResource TextFillColorTertiaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4">
                        <ItemsControl x:Name="PART_PropertiesList" ItemsSource="{TemplateBinding Entries}" ItemTemplateSelector="{TemplateBinding EntryTemplateSelector}" />
                    </ScrollViewer>
                    <TextBlock x:Name="PART_EmptyMessage" Grid.Row="2" Text="No matching properties" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid x:Name="PART_DescriptionArea" Grid.Row="3" Background="{ThemeResource ControlFillColorTertiaryBrush}">
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Top" />
                        <StackPanel Margin="12,9,12,8">
                            <TextBlock x:Name="PART_PropertyNameText" Text="{TemplateBinding SelectedPropertyName}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3" />
                            <TextBlock x:Name="PART_PropertyDescriptionText" Text="{TemplateBinding SelectedPropertyDescription}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </ControlTemplate></Setter>
    </Style>
</ResourceDictionary>
