<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- ProgressBar Style -->
    <!-- ============================================== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{ThemeResource SliderTrack}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
        <Setter Property="ProgressBrush" Value="{ThemeResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ProgressBar">
                <Border Name="PART_Track"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Shape="RoundedRectangle">
                    <Grid>
                        <!-- Progress Indicator -->
                        <Border Name="PART_Indicator"
                                Background="{TemplateBinding ProgressBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Shape="RoundedRectangle"
                                HorizontalAlignment="Left" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="PART_Track" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                        <Setter TargetName="PART_Indicator" Property="Background" Value="{ThemeResource AccentBrushDisabled}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- Slider Style -->
    <!-- ============================================== -->
    <Style TargetType="Slider">
        <Setter Property="TrackBrush" Value="{ThemeResource SliderTrack}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Slider">
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Shape="RoundedRectangle">
                  <Grid>
                    <!-- Track Background -->
                    <Rectangle Name="PART_Track"
                               Fill="{TemplateBinding TrackBrush}"
                               Height="4"
                               RadiusX="2"
                               RadiusY="2"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0" />

                    <!-- Filled Track -->
                    <Rectangle Name="PART_SelectionRange"
                               Fill="{TemplateBinding Foreground}"
                               Height="4"
                               RadiusX="2"
                               RadiusY="2"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="8,0,8,0" />

                    <!-- Segmented Track (replaces the two rectangles above when TrackMode="Segmented") -->
                    <SegmentedTrackBar Name="PART_Segments"
                                       Visibility="Collapsed"
                                       TrackThickness="4"
                                       ReservedSpace="16"
                                       TrackBrush="{TemplateBinding TrackBrush}"
                                       Fill="{TemplateBinding Foreground}" />

                    <!-- Thumb -->
                    <Grid Name="PART_Thumb"
                          Width="16"
                          Height="16"
                          Background="Transparent"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        <Ellipse Name="PART_ThumbVisual"
                                 TransitionProperty="Width,Height"
                                 TransitionDuration="0:0:0.14"
                                 TransitionTimingFunction="Recommended"
                                 Width="10"
                                 Height="10"
                                 Fill="{TemplateBinding Foreground}"
                                 StrokeThickness="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter TargetName="PART_Track" Property="Width" Value="4" />
                        <Setter TargetName="PART_Track" Property="Height" Value="Auto" />
                        <Setter TargetName="PART_Track" Property="HorizontalAlignment" Value="Center" />
                        <Setter TargetName="PART_Track" Property="VerticalAlignment" Value="Stretch" />
                        <Setter TargetName="PART_Track" Property="Margin" Value="0,8,0,8" />
                        <Setter TargetName="PART_SelectionRange" Property="Width" Value="4" />
                        <Setter TargetName="PART_SelectionRange" Property="HorizontalAlignment" Value="Center" />
                        <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Center" />
                        <Setter TargetName="PART_Thumb" Property="VerticalAlignment" Value="Top" />
                    </Trigger>
                    <Trigger Property="TrackMode" Value="Segmented">
                        <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="PART_SelectionRange" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="PART_Segments" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{ThemeResource AccentBrushHover}" />
                        <Setter TargetName="PART_Segments" Property="Fill" Value="{ThemeResource AccentBrushHover}" />
                        <Setter TargetName="PART_ThumbVisual" Property="Fill" Value="{ThemeResource AccentBrushHover}" />
                        <Setter TargetName="PART_ThumbVisual" Property="Width" Value="14" />
                        <Setter TargetName="PART_ThumbVisual" Property="Height" Value="14" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="PART_ThumbVisual" Property="Width" Value="14" />
                        <Setter TargetName="PART_ThumbVisual" Property="Height" Value="14" />
                    </Trigger>
                    <Trigger Property="IsMouseCaptured" Value="True">
                        <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{ThemeResource AccentBrushPressed}" />
                        <Setter TargetName="PART_Segments" Property="Fill" Value="{ThemeResource AccentBrushPressed}" />
                        <Setter TargetName="PART_ThumbVisual" Property="Fill" Value="{ThemeResource AccentBrushPressed}" />
                        <Setter TargetName="PART_ThumbVisual" Property="Width" Value="16" />
                        <Setter TargetName="PART_ThumbVisual" Property="Height" Value="16" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="PART_Track" Property="Fill" Value="{ThemeResource ControlBackgroundDisabled}" />
                        <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{ThemeResource AccentBrushDisabled}" />
                        <Setter TargetName="PART_Segments" Property="TrackBrush" Value="{ThemeResource ControlBackgroundDisabled}" />
                        <Setter TargetName="PART_Segments" Property="Fill" Value="{ThemeResource AccentBrushDisabled}" />
                        <Setter TargetName="PART_ThumbVisual" Property="Fill" Value="{ThemeResource AccentBrushDisabled}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- RangeSlider Style -->
    <!-- ============================================== -->
    <Style TargetType="RangeSlider">
        <Setter Property="TrackBrush" Value="{ThemeResource SliderTrack}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WindowBackground}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <ControlTemplate TargetType="RangeSlider">
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Shape="RoundedRectangle">
                  <Grid>
                    <Rectangle Name="PART_Track"
                               Fill="{TemplateBinding TrackBrush}"
                               Height="4"
                               RadiusX="2"
                               RadiusY="2"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0" />
                    <Rectangle Name="PART_SelectionRange"
                               Fill="{TemplateBinding Foreground}"
                               Height="4"
                               RadiusX="2"
                               RadiusY="2"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />
                    <SegmentedTrackBar Name="PART_Segments"
                                       Visibility="Collapsed"
                                       TrackThickness="4"
                                       ReservedSpace="16"
                                       TrackBrush="{TemplateBinding TrackBrush}"
                                       Fill="{TemplateBinding Foreground}" />
                    <Ellipse Name="PART_StartThumb"
                             TransitionProperty="Stroke"
                             TransitionDuration="0:0:0.12"
                             TransitionTimingFunction="Recommended"
                             Width="18"
                             Height="18"
                             Fill="{TemplateBinding Foreground}"
                             Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="2"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
                    <Ellipse Name="PART_EndThumb"
                             TransitionProperty="Stroke"
                             TransitionDuration="0:0:0.12"
                             TransitionTimingFunction="Recommended"
                             Width="18"
                             Height="18"
                             Fill="{TemplateBinding Foreground}"
                             Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="2"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter TargetName="PART_Track" Property="Width" Value="4" />
                        <Setter TargetName="PART_Track" Property="Height" Value="Auto" />
                        <Setter TargetName="PART_Track" Property="HorizontalAlignment" Value="Center" />
                        <Setter TargetName="PART_Track" Property="VerticalAlignment" Value="Stretch" />
                        <Setter TargetName="PART_Track" Property="Margin" Value="0,8,0,8" />
                        <Setter TargetName="PART_SelectionRange" Property="Width" Value="4" />
                        <Setter TargetName="PART_SelectionRange" Property="HorizontalAlignment" Value="Center" />
                        <Setter TargetName="PART_StartThumb" Property="HorizontalAlignment" Value="Center" />
                        <Setter TargetName="PART_StartThumb" Property="VerticalAlignment" Value="Top" />
                        <Setter TargetName="PART_EndThumb" Property="HorizontalAlignment" Value="Center" />
                        <Setter TargetName="PART_EndThumb" Property="VerticalAlignment" Value="Top" />
                    </Trigger>
                    <Trigger Property="TrackMode" Value="Segmented">
                        <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="PART_SelectionRange" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="PART_Segments" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{ThemeResource AccentBrushHover}" />
                        <Setter TargetName="PART_Segments" Property="Fill" Value="{ThemeResource AccentBrushHover}" />
                        <Setter TargetName="PART_StartThumb" Property="Fill" Value="{ThemeResource AccentBrushHover}" />
                        <Setter TargetName="PART_EndThumb" Property="Fill" Value="{ThemeResource AccentBrushHover}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="PART_StartThumb" Property="Stroke" Value="{ThemeResource ControlBorderFocused}" />
                        <Setter TargetName="PART_EndThumb" Property="Stroke" Value="{ThemeResource ControlBorderFocused}" />
                    </Trigger>
                    <Trigger Property="IsMouseCaptured" Value="True">
                        <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{ThemeResource AccentBrushPressed}" />
                        <Setter TargetName="PART_Segments" Property="Fill" Value="{ThemeResource AccentBrushPressed}" />
                        <Setter TargetName="PART_StartThumb" Property="Fill" Value="{ThemeResource AccentBrushPressed}" />
                        <Setter TargetName="PART_EndThumb" Property="Fill" Value="{ThemeResource AccentBrushPressed}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="PART_Track" Property="Fill" Value="{ThemeResource ControlBackgroundDisabled}" />
                        <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{ThemeResource AccentBrushDisabled}" />
                        <Setter TargetName="PART_Segments" Property="TrackBrush" Value="{ThemeResource ControlBackgroundDisabled}" />
                        <Setter TargetName="PART_Segments" Property="Fill" Value="{ThemeResource AccentBrushDisabled}" />
                        <Setter TargetName="PART_StartThumb" Property="Fill" Value="{ThemeResource AccentBrushDisabled}" />
                        <Setter TargetName="PART_EndThumb" Property="Fill" Value="{ThemeResource AccentBrushDisabled}" />
                        <Setter TargetName="PART_StartThumb" Property="Stroke" Value="{ThemeResource ControlBorderDisabled}" />
                        <Setter TargetName="PART_EndThumb" Property="Stroke" Value="{ThemeResource ControlBorderDisabled}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- TickBar Style -->
    <!-- ============================================== -->
    <Style TargetType="TickBar">
        <Setter Property="Fill" Value="{ThemeResource TextSecondary}" />
    </Style>

    <!-- ============================================== -->
    <!-- Thumb Style -->
    <!-- ============================================== -->
    <Style TargetType="Thumb">
        <Setter Property="Background" Value="{ThemeResource ControlBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Thumb">
                <Grid>
                    <Border Name="ThumbBorder"
                            TransitionProperty="BorderBrush"
                            TransitionDuration="0:0:0.12"
                            TransitionTimingFunction="Recommended"
                            Shape="RoundedRectangle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- Grip Lines -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <Rectangle Height="1" Width="6" Fill="{ThemeResource TextTertiary}" Margin="0,0,0,2" />
                                <Rectangle Height="1" Width="6" Fill="{ThemeResource TextTertiary}" Margin="0,0,0,2" />
                                <Rectangle Height="1" Width="6" Fill="{ThemeResource TextTertiary}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ThumbBorder" Property="Background" Value="{ThemeResource ControlBackgroundHover}" />
                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderHover}" />
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="ThumbBorder" Property="Background" Value="{ThemeResource ControlBackgroundPressed}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="ThumbBorder" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

