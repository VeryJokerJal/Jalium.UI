<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ribbon="clr-namespace:Jalium.UI.Controls.Ribbon">
    <Style x:Key="Ribbon.Groups" TargetType="ItemsControl">
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate TargetType="ItemsControl"><ItemsPresenter /></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ribbon:Ribbon">
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" /><Setter Property="Foreground" Value="{ThemeResource TextPrimary}" /><Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" /><Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="ItemContainerStyle" Value="{Binding TabHeaderStyle, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:Ribbon"><Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="DisplayStates"><VisualState x:Name="Expanded" /><VisualState x:Name="Minimized"><VisualState.Setters><Setter TargetName="PART_GroupScroll" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState><VisualState x:Name="Collapsed"><VisualState.Setters><Setter TargetName="PART_Root" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter TargetName="PART_Root" Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="QuickAccessStates"><VisualState x:Name="QuickAccessTop" /><VisualState x:Name="QuickAccessBottom"><VisualState.Setters><Setter TargetName="PART_QuickAccess" Property="HorizontalAlignment" Value="Left" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="TitleStates"><VisualState x:Name="TitleVisible" /><VisualState x:Name="TitleHidden"><VisualState.Setters><Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

            <ContentPresenter x:Name="PART_Title" Content="{TemplateBinding Title}" ContentTemplate="{TemplateBinding TitleTemplate}" Margin="12,6" VerticalAlignment="Center" />
            <ContentPresenter x:Name="PART_QuickAccess" Grid.Row="{TemplateBinding QuickAccessRow}" Grid.Column="{TemplateBinding QuickAccessColumn}" Content="{TemplateBinding QuickAccessToolBar}" Margin="6,2" VerticalAlignment="Center" />
            <DockPanel x:Name="PART_Headers" Grid.Row="1" Grid.ColumnSpan="2">
                <ContentPresenter x:Name="PART_ApplicationMenu" DockPanel.Dock="Left" Content="{TemplateBinding ApplicationMenu}" />
                <ContentPresenter x:Name="PART_HelpPane" DockPanel.Dock="Right" Content="{TemplateBinding HelpPaneContent}" ContentTemplate="{TemplateBinding HelpPaneContentTemplate}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsPresenter x:Name="PART_TabHeaders" /></ScrollViewer>
            </DockPanel>
            <ScrollViewer x:Name="PART_GroupScroll" Grid.Row="2" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="PART_InlineGroups" Style="{StaticResource Ribbon.Groups}" ItemsSource="{TemplateBinding InlineGroupsSource}" /></ScrollViewer>
            <Popup x:Name="PART_DropDown" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Headers}" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" StaysOpen="False">
                <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource ControlBorder}" BorderThickness="1" Padding="4" MinWidth="240"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="360"><ItemsControl x:Name="PART_PopupGroups" Style="{StaticResource Ribbon.Groups}" ItemsSource="{TemplateBinding PopupGroupsSource}" /></ScrollViewer></Border>
            </Popup>
        </Grid></Border></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ribbon:RibbonTab">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="HeaderTemplate" Value="{Binding Ribbon.TabHeaderTemplate, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:RibbonTab"><Grid>
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Unselected" /><VisualState x:Name="Selected"><VisualState.Setters><Setter TargetName="PART_Indicator" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <Button x:Name="PART_HeaderButton" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" ContentStringFormat="{TemplateBinding HeaderStringFormat}" Background="Transparent" BorderThickness="0" CornerRadius="4,4,0,0" MinHeight="0" Padding="14,8" Foreground="{TemplateBinding Foreground}" />
            <Border x:Name="PART_Indicator" Height="2" Background="{ThemeResource AccentBrush}" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ribbon:RibbonGroup">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,4" /><Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" /><Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:RibbonGroup"><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><StackPanel><ItemsPresenter /><ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{ThemeResource TextSecondary}" FontSize="12" HorizontalAlignment="Center" Margin="4,8,4,0" /></StackPanel></Border></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ribbon:RibbonQuickAccessToolBar">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:RibbonQuickAccessToolBar"><ItemsPresenter /></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ribbon:RibbonContextualTabGroup">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:RibbonContextualTabGroup"><Border Background="{TemplateBinding Background}" Padding="8,4"><ContentPresenter Content="{TemplateBinding Header}" /></Border></ControlTemplate></Setter>
        <Style.Triggers><Trigger Property="IsGroupVisible" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ribbon:RibbonButton" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="{Binding Label, RelativeSource={RelativeSource Self}}" /><Setter Property="Padding" Value="10,6" /><Setter Property="MinHeight" Value="30" /></Style>
    <Style TargetType="ribbon:RibbonToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Content" Value="{Binding Label, RelativeSource={RelativeSource Self}}" /><Setter Property="Padding" Value="10,6" /><Setter Property="MinHeight" Value="30" /></Style>
    <Style TargetType="ribbon:RibbonCheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Content" Value="{Binding Label, RelativeSource={RelativeSource Self}}" /></Style>
    <Style TargetType="ribbon:RibbonTextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
    <Style TargetType="ribbon:RibbonSeparator" BasedOn="{StaticResource {x:Type Separator}}" />
    <Style TargetType="ribbon:RibbonMenuButton">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" /><Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:RibbonMenuButton"><Grid>
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="DropDownStates"><VisualState x:Name="Opened" /><VisualState x:Name="Closed" /></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <Button x:Name="PART_HeaderButton" Padding="10,6" MinHeight="30"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=ribbon:RibbonMenuButton}}" /><TextBlock Text="⌄" /></StackPanel></Button>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" StaysOpen="False"><Border x:Name="PART_MenuRoot" Background="{TemplateBinding Background}" BorderBrush="{ThemeResource ControlBorder}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="160"><ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer></Border></Popup>
        </Grid></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ribbon:RibbonSplitButton" BasedOn="{StaticResource {x:Type ribbon:RibbonMenuButton}}">
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:RibbonSplitButton"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="PART_HeaderButton" Content="{TemplateBinding Label}" Padding="10,6" MinHeight="30" CornerRadius="4,0,0,4" />
            <Button x:Name="PART_DropDownButton" Grid.Column="1" Content="⌄" Padding="6" MinWidth="20" MinHeight="30" CornerRadius="0,4,4,0" />
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" StaysOpen="False"><Border x:Name="PART_MenuRoot" Background="{TemplateBinding Background}" BorderBrush="{ThemeResource ControlBorder}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="160"><ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer></Border></Popup>
        </Grid></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ribbon:RibbonComboBox" BasedOn="{StaticResource {x:Type ribbon:RibbonMenuButton}}"><Setter Property="Label" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>
    <Style TargetType="ribbon:RibbonApplicationMenu" BasedOn="{StaticResource {x:Type ribbon:RibbonMenuButton}}"><Setter Property="Label" Value="File" /></Style>
    <Style TargetType="ribbon:RibbonMenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" />
    <Style TargetType="ribbon:RibbonSplitMenuItem" BasedOn="{StaticResource {x:Type ribbon:RibbonMenuItem}}" />
    <Style TargetType="ribbon:RibbonApplicationMenuItem" BasedOn="{StaticResource {x:Type ribbon:RibbonMenuItem}}" />
    <Style TargetType="ribbon:RibbonApplicationSplitMenuItem" BasedOn="{StaticResource {x:Type ribbon:RibbonSplitMenuItem}}" />
    <Style TargetType="ribbon:RibbonGallery">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:RibbonGallery"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ItemsPresenter /></Border></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ribbon:RibbonGalleryCategory">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:RibbonGalleryCategory"><StackPanel><ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Margin="4" /><ItemsPresenter /></StackPanel></ControlTemplate></Setter>
    </Style>
    <Style TargetType="ribbon:RibbonGalleryItem">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Template"><ControlTemplate TargetType="ribbon:RibbonGalleryItem"><Border x:Name="PART_Selection" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4"><Button x:Name="PART_Button" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="8,4" MinHeight="28" MinWidth="0" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="PART_Selection" Property="BorderBrush" Value="{ThemeResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter>
    </Style>
</ResourceDictionary>
