<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- ScrollBar Line Button Style -->
    <!-- ============================================== -->
    <Style x:Key="ScrollBarLineButtonStyle" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource ScrollBarArrow}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="RepeatButton">
                <Border Name="PART_ButtonRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Shape="RoundedRectangle"
                        TransitionProperty="None">
                    <Path Name="PART_Arrow"
                          Data="M 841.90,426.67 L 273.07,0 A 170.67,170.67,0,0,0,0,136.53 V 989.87 A 170.67,170.67,0,0,0,273.07,1126.40 L 841.90,699.73 A 170.67,170.67,0,0,0,841.90,426.67 Z"
                          Fill="{TemplateBinding Foreground}"
                          Width="8"
                          Height="8"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="Up">
                        <Setter TargetName="PART_Arrow" Property="Data" Value="M 733.87,0 L 1160.54,568.83 A 170.67,170.67,0,0,1,1024.00,841.90 H 170.67 A 170.67,170.67,0,0,1,34.14,568.83 L 460.80,0 A 170.67,170.67,0,0,1,733.87,0 Z" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Down">
                        <Setter TargetName="PART_Arrow" Property="Data" Value="M 733.87,841.90 L 1160.54,273.07 A 170.67,170.67,0,0,0,1024.00,0 H 170.67 A 170.67,170.67,0,0,0,34.14,273.07 L 460.80,841.90 A 170.67,170.67,0,0,0,733.87,841.90 Z" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Left">
                        <Setter TargetName="PART_Arrow" Property="Data" Value="M 0,426.67 L 568.83,0 A 170.67,170.67,0,0,1,841.90,136.53 V 989.87 A 170.67,170.67,0,0,1,568.83,1126.40 L 0,699.73 A 170.67,170.67,0,0,1,0,426.67 Z" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Right">
                        <Setter TargetName="PART_Arrow" Property="Data" Value="M 841.90,426.67 L 273.07,0 A 170.67,170.67,0,0,0,0,136.53 V 989.87 A 170.67,170.67,0,0,0,273.07,1126.40 L 841.90,699.73 A 170.67,170.67,0,0,0,841.90,426.67 Z" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_ButtonRoot" Property="Background" Value="{ThemeResource ControlBackgroundHover}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="PART_ButtonRoot" Property="Background" Value="{ThemeResource ControlBackgroundPressed}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="PART_ButtonRoot" Property="Background" Value="Transparent" />
                        <Setter TargetName="PART_ButtonRoot" Property="BorderBrush" Value="Transparent" />
                        <Setter TargetName="PART_Arrow" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- ScrollBar Page Button Style -->
    <!-- ============================================== -->
    <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="RepeatButton">
                <Border Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- ScrollBar Thumb Style -->
    <!-- ============================================== -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Style.Resources>
            <ControlTemplate x:Key="ScrollBarPlainThumbTemplate" TargetType="Thumb">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Margin="{TemplateBinding Padding}" TransitionProperty="None" />
            </ControlTemplate>
        </Style.Resources>
        <Setter Property="Background" Value="{ThemeResource ScrollBarThumb}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- Fully rounded: the renderer clamps the radius to half the thumb's short side, so a
             long thumb reads as a capsule/pill and a minimum-size thumb (huge content) reads as
             a round dot. -->
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="ShowGrip" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Thumb">
                <Border Name="ThumbBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        TransitionProperty="None"
                        Margin="{TemplateBinding Padding}" />
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ThumbBorder" Property="Background" Value="{ThemeResource ScrollBarThumbHover}" />
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="ThumbBorder" Property="Background" Value="{ThemeResource ScrollBarThumbActive}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="ThumbBorder" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="Transparent" />
                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ScrollBarTemplate" TargetType="ScrollBar">
        <Grid x:Name="ScrollBarRoot">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters><Setter TargetName="ScrollBarRoot" Property="Opacity" Value="1" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters><Setter TargetName="ScrollBarRoot" Property="Opacity" Value="0.45" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="OrientationStates">
                    <VisualState x:Name="Vertical" />
                    <VisualState x:Name="Horizontal" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="PresentationStates">
                    <VisualState x:Name="Persistent" />
                    <VisualState x:Name="Overlay" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="ThumbStates">
                    <VisualState x:Name="Expanded" />
                    <VisualState x:Name="Slim" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="PART_Chrome" IsHitTestVisible="False"
                    Margin="{TemplateBinding ChromeInsets}" Opacity="{TemplateBinding ChromeOpacity}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    BackdropEffect="{TemplateBinding BackdropEffect}" TransitionProperty="None" />
            <ScrollBarLayoutPanel Margin="{TemplateBinding PartsInsets}"
                                  Orientation="{TemplateBinding Orientation}"
                                  UsesLineButtons="{TemplateBinding HasLineButtons}"
                                  PreferredThickness="{TemplateBinding NaturalThickness}">
                <RepeatButton x:Name="PART_LineDecreaseButton" ScrollBarLayoutPanel.Role="DecreaseLine"
                              Style="{TemplateBinding LineButtonStyle}" Tag="{TemplateBinding DecreaseDirection}"
                              IsHitTestVisible="{TemplateBinding HasLineButtons}" Visibility="{TemplateBinding LineButtonsVisibility}" Opacity="{TemplateBinding ChromeOpacity}"
                              Focusable="False" ClickMode="Press" />
                <Track x:Name="PART_Track" ScrollBarLayoutPanel.Role="Track"
                       Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"
                       ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{TemplateBinding PageButtonStyle}" Focusable="False" ClickMode="Press" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{TemplateBinding ThumbStyle}" Width="Auto" Height="Auto" Focusable="False" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{TemplateBinding PageButtonStyle}" Focusable="False" ClickMode="Press" />
                    </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton x:Name="PART_LineIncreaseButton" ScrollBarLayoutPanel.Role="IncreaseLine"
                              Style="{TemplateBinding LineButtonStyle}" Tag="{TemplateBinding IncreaseDirection}"
                              IsHitTestVisible="{TemplateBinding HasLineButtons}" Visibility="{TemplateBinding LineButtonsVisibility}" Opacity="{TemplateBinding ChromeOpacity}"
                              Focusable="False" ClickMode="Press" />
            </ScrollBarLayoutPanel>
        </Grid>
    </ControlTemplate>

    <Style x:Key="ScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Background" Value="{ThemeResource ScrollBarTrack}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="LineButtonStyle" Value="{ThemeResource ScrollBarLineButtonStyle}" />
        <Setter Property="PageButtonStyle" Value="{ThemeResource ScrollBarPageButtonStyle}" />
        <Setter Property="ThumbStyle" Value="{ThemeResource ScrollBarThumbStyle}" />
        <Setter Property="Template" Value="{StaticResource ScrollBarTemplate}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarStyle}" />
</ResourceDictionary>
