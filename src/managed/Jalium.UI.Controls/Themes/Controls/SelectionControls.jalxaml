<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- ============================================== -->
	<!-- ComboBox Style -->
	<!-- ============================================== -->
	<Style TargetType="ComboBox">
		<Setter Property="ScrollViewer.CanContentScroll" Value="True" />
		<Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
		<Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="10,5,6,5" />
		<Setter Property="CornerRadius" Value="11" />
		<Setter Property="MinHeight" Value="38" />
		<Setter Property="Template">
			<ControlTemplate TargetType="ComboBox">
				<Grid>
					<Border Name="PART_MainBorder"
                            TransitionProperty="BorderBrush"
                            TransitionDuration="0:0:0.12"
                            TransitionTimingFunction="Recommended"
                            Shape="RoundedRectangle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
						<Border Name="PART_InnerBorder"
                                CornerRadius="10"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1"
                                Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
							<Grid Margin="2,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="30" />
								</Grid.ColumnDefinitions>

								<Border Name="PART_AccentPip"
                                        Grid.Column="0"
                                        Width="3"
                                        Height="14"
                                        CornerRadius="1.5"
                                        Margin="0,0,9,0"
                                        VerticalAlignment="Center"
                                        Background="#667CA8FF" />

								<Grid Grid.Column="1">
									<ContentPresenter Name="PART_SelectionPresenter"
                                                      Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                      ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                      ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                      ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center">
										<ContentPresenter.Resources>
											<Style TargetType="TextBlock">
												<Setter Property="TextTrimming" Value="CharacterEllipsis" />
												<Setter Property="TextWrapping" Value="NoWrap" />
											</Style>
											<Style TargetType="AccessText">
												<Setter Property="TextTrimming" Value="CharacterEllipsis" />
												<Setter Property="TextWrapping" Value="NoWrap" />
											</Style>
										</ContentPresenter.Resources>
									</ContentPresenter>

									<TextBox Name="PART_EditableTextBox"
                                             Text="{Binding Text, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             PlaceholderText="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MinHeight="0"
                                             Padding="0"
                                             Visibility="Collapsed"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
								</Grid>

								<Grid Name="PART_DropDownArea"
                                      Grid.Column="2"
                                      Background="Transparent">
									<Rectangle Name="PART_DropDownDivider"
                                               Width="1"
                                               Margin="0,1,0,1"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Stretch"
                                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
									<ToggleButton Name="PART_ToggleButton"
                                                  Margin="2,0,0,0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0"
                                                  MinWidth="26"
                                                  MinHeight="26"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  IsChecked="{TemplateBinding IsDropDownOpen}">
										<ToggleButton.Template>
											<ControlTemplate TargetType="ToggleButton">
												<Border Name="ToggleSurface"
                                                        Width="24"
                                                        Height="24"
                                                        CornerRadius="7"
                                                        TransitionProperty="None"
                                                        Background="#12FFFFFF"
                                                        BorderBrush="#24FFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
													<Path Name="PART_DropDownGlyph"
                                                          Data="M 1.6,3.2 L 6.0,7.6 L 10.4,3.2 L 9.1,1.9 L 6.0,5.0 L 2.9,1.9 Z"
                                                          Fill="{ThemeResource TextSecondary}"
                                                          Width="9"
                                                          Height="9"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="ToggleSurface" Property="Background" Value="#247CA8FF" />
														<Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#527CA8FF" />
													</Trigger>
													<Trigger Property="IsChecked" Value="True">
														<Setter TargetName="ToggleSurface" Property="Background" Value="#335A8BF3" />
														<Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#7CA8FF" />
														<Setter TargetName="PART_DropDownGlyph" Property="Fill" Value="#96B9FF" />
													</Trigger>
													<Trigger Property="IsPressed" Value="True">
														<Setter TargetName="ToggleSurface" Property="Background" Value="#335A8BF3" />
													</Trigger>
													<Trigger Property="IsEnabled" Value="False">
														<Setter TargetName="ToggleSurface" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
														<Setter TargetName="PART_DropDownGlyph" Property="Fill" Value="{ThemeResource TextDisabled}" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</ToggleButton.Template>
									</ToggleButton>
								</Grid>
							</Grid>
						</Border>
					</Border>
					<Popup Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           StaysOpen="False"
                           Placement="Bottom"
                           PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}}">
						<Border Name="PART_PopupBorder"
                                Margin="0,6,0,0"
                                Background="{ThemeResource SurfaceBackground}"
                                BorderBrush="{ThemeResource ControlBorder}"
                                BorderThickness="1"
                                CornerRadius="13"
                                Shape="RoundedRectangle">
							<Border CornerRadius="12"
                                    BorderBrush="#1FFFFFFF"
                                    BorderThickness="1"
                                    Padding="5">
								<Grid>
									<Border Height="1"
                                            Margin="14,0,14,0"
                                            VerticalAlignment="Top"
                                            Background="#557CA8FF" />
									<ScrollViewer Margin="0,2,0,0"
                                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  IsOverlayScrollBarEnabled="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
										<ItemsPresenter />
									</ScrollViewer>
								</Grid>
							</Border>
						</Border>
					</Popup>
				</Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEditable" Value="False">
                        <Setter TargetName="PART_DropDownDivider" Property="Opacity" Value="0" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderHover}" />
                        <Setter TargetName="PART_AccentPip" Property="Background" Value="#997CA8FF" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
                        <Setter TargetName="PART_AccentPip" Property="Background" Value="#7CA8FF" />
                    </Trigger>
                    <Trigger Property="IsDropDownOpen" Value="True">
                        <Setter TargetName="PART_MainBorder" Property="Background" Value="{ThemeResource ControlBackgroundPressed}" />
                        <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
                        <Setter TargetName="PART_AccentPip" Property="Background" Value="#7CA8FF" />
                        <Setter TargetName="PART_AccentPip" Property="Height" Value="16" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="PART_MainBorder" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                        <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
                    </Trigger>
                </ControlTemplate.Triggers>
			</ControlTemplate>
		</Setter>

		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- ============================================== -->
	<!-- ComboBoxItem Style -->
	<!-- ============================================== -->
	<Style TargetType="ComboBoxItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="10,6,10,6" />
		<Setter Property="MinHeight" Value="34" />
		<Setter Property="Template">
			<ControlTemplate TargetType="ComboBoxItem">
				<Border Name="PART_BackgroundBorder"
                        Margin="0,1,0,1"
                        TransitionProperty="None"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="9"
                        Shape="RoundedRectangle"
                        Padding="{TemplateBinding Padding}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Border Name="PART_SelectBar"
                                Grid.Column="0"
                                Width="3"
                                Height="14"
                                CornerRadius="1.5"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlBorderFocused}"
                                Opacity="0.22" />
						<ContentPresenter Grid.Column="1" VerticalAlignment="Center">
							<ContentPresenter.Resources>
								<Style TargetType="TextBlock">
									<Setter Property="TextTrimming" Value="CharacterEllipsis" />
									<Setter Property="TextWrapping" Value="NoWrap" />
								</Style>
								<Style TargetType="AccessText">
									<Setter Property="TextTrimming" Value="CharacterEllipsis" />
									<Setter Property="TextWrapping" Value="NoWrap" />
								</Style>
							</ContentPresenter.Resources>
						</ContentPresenter>
						<Border Name="PART_CheckBadge"
                                Grid.Column="2"
                                Width="20"
                                Height="20"
                                CornerRadius="6"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Background="#2E5A8BF3"
                                BorderBrush="#667CA8FF"
                                BorderThickness="1"
                                Opacity="0">
							<Path Data="M 1.5,5.2 L 4.2,7.9 L 9.5,2.2 L 8.4,1.1 L 4.2,5.6 L 2.6,4.0 Z"
                                  Fill="{ThemeResource ControlBorderFocused}"
                                  Width="9"
                                  Height="9"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
						</Border>
					</Grid>
				</Border>
				<ControlTemplate.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource HighlightBackground}" />
						<Setter TargetName="PART_BackgroundBorder" Property="BorderBrush" Value="#387CA8FF" />
						<Setter TargetName="PART_SelectBar" Property="Opacity" Value="0.68" />
					</Trigger>
					<Trigger Property="IsHighlighted" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource HighlightBackground}" />
						<Setter TargetName="PART_BackgroundBorder" Property="BorderBrush" Value="#387CA8FF" />
						<Setter TargetName="PART_SelectBar" Property="Opacity" Value="0.68" />
					</Trigger>
					<Trigger Property="IsSelected" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource SelectionBackground}" />
						<Setter TargetName="PART_BackgroundBorder" Property="BorderBrush" Value="#667CA8FF" />
						<Setter TargetName="PART_SelectBar" Property="Opacity" Value="1" />
						<Setter TargetName="PART_SelectBar" Property="Height" Value="16" />
						<Setter TargetName="PART_CheckBadge" Property="Opacity" Value="1" />
					</Trigger>
					<Trigger Property="IsKeyboardFocused" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
					</Trigger>
					<Trigger Property="IsEnabled" Value="False">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
						<Setter TargetName="PART_BackgroundBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
						<Setter TargetName="PART_BackgroundBorder" Property="Opacity" Value="0.55" />
					</Trigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- ============================================== -->
	<!-- ListBox Style -->
	<!-- ============================================== -->
	<Style TargetType="ListBox">
		<Setter Property="ScrollViewer.CanContentScroll" Value="True" />
		<Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
		<Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="Padding" Value="2" />
		<Setter Property="Template">
			<ControlTemplate TargetType="ListBox">
				<Grid>
					<Border Name="PART_OuterBorder"
                            TransitionProperty="BorderBrush"
                            TransitionDuration="0:0:0.12"
                            TransitionTimingFunction="Recommended"
                            Shape="RoundedRectangle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
						<ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
							<ItemsPresenter />
						</ScrollViewer>
					</Border>
				</Grid>
				<ControlTemplate.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter TargetName="PART_OuterBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderHover}" />
					</Trigger>
					<Trigger Property="IsKeyboardFocused" Value="True">
						<Setter TargetName="PART_OuterBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
					</Trigger>
					<Trigger Property="IsEnabled" Value="False">
						<Setter TargetName="PART_OuterBorder" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
						<Setter TargetName="PART_OuterBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
					</Trigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>
		</Setter>

		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- ============================================== -->
	<!-- ListBoxItem Style -->
	<!-- ============================================== -->
	<Style TargetType="ListBoxItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="10,6,10,6" />
		<Setter Property="MinHeight" Value="30" />
		<Setter Property="Template">
			<ControlTemplate TargetType="ListBoxItem">
				<Grid>
					<Border Name="PART_BackgroundBorder"
                            TransitionProperty="None"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Shape="RoundedRectangle"
                            Padding="{TemplateBinding Padding}">
						<ContentPresenter VerticalAlignment="Center" />
					</Border>
				</Grid>
				<ControlTemplate.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource HighlightBackground}" />
					</Trigger>
					<Trigger Property="IsSelected" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource SelectionBackground}" />
					</Trigger>
					<Trigger Property="IsKeyboardFocused" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
					</Trigger>
					<Trigger Property="IsEnabled" Value="False">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
						<Setter TargetName="PART_BackgroundBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
						<Setter TargetName="PART_BackgroundBorder" Property="Opacity" Value="0.55" />
					</Trigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- ============================================== -->
	<!-- ListView Style -->
	<!-- ============================================== -->
	<Style TargetType="ListView">
		<Setter Property="ScrollViewer.CanContentScroll" Value="True" />
		<Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
		<Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="Template">
			<ControlTemplate TargetType="ListView">
				<Grid>
					<Border Name="PART_OuterBorder"
                            TransitionProperty="BorderBrush"
                            TransitionDuration="0:0:0.12"
                            TransitionTimingFunction="Recommended"
                            Shape="RoundedRectangle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<!-- Column headers (visible when using GridView) -->
							<Grid Name="PART_ColumnHeadersBorder"
                                  Grid.Row="0"
                                  Background="{ThemeResource SurfaceBackground}"
                                  Visibility="Collapsed">
								<StackPanel Name="PART_ColumnHeadersHost" Orientation="Horizontal" />
                                <Rectangle Height="1"
                                           VerticalAlignment="Bottom"
                                           Fill="{ThemeResource ControlBorder}"
                                           IsHitTestVisible="False" />
							</Grid>
							<!-- Items area -->
							<ScrollViewer Grid.Row="1"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
								<ItemsPresenter />
							</ScrollViewer>
						</Grid>
					</Border>
				</Grid>
				<ControlTemplate.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter TargetName="PART_OuterBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderHover}" />
					</Trigger>
					<Trigger Property="IsKeyboardFocused" Value="True">
						<Setter TargetName="PART_OuterBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
					</Trigger>
					<Trigger Property="IsEnabled" Value="False">
						<Setter TargetName="PART_OuterBorder" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
						<Setter TargetName="PART_OuterBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
					</Trigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>
		</Setter>

		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- ============================================== -->
	<!-- ListViewItem Style -->
	<!-- ============================================== -->
	<Style TargetType="ListViewItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="10,5,10,5" />
		<Setter Property="MinHeight" Value="30" />
		<Setter Property="Template">
			<ControlTemplate TargetType="ListViewItem">
				<Grid>
					<Border Name="PART_BackgroundBorder"
                            TransitionProperty="None"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Shape="RoundedRectangle"
                            Padding="{TemplateBinding Padding}">
						<StackPanel Name="PART_CellsPanel" Orientation="Horizontal">
							<ContentPresenter VerticalAlignment="Center" />
						</StackPanel>
					</Border>
				</Grid>
				<ControlTemplate.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource HighlightBackground}" />
					</Trigger>
					<Trigger Property="IsSelected" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource SelectionBackground}" />
					</Trigger>
					<Trigger Property="IsKeyboardFocused" Value="True">
						<Setter TargetName="PART_BackgroundBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
					</Trigger>
					<Trigger Property="IsEnabled" Value="False">
						<Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
						<Setter TargetName="PART_BackgroundBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
						<Setter TargetName="PART_BackgroundBorder" Property="Opacity" Value="0.55" />
					</Trigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- ============================================== -->
	<!-- GridViewColumnHeader Style -->
	<!-- ============================================== -->
	<Style TargetType="GridViewColumnHeader">
		<Setter Property="Background" Value="{ThemeResource ControlBackground}" />
		<Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
		<Setter Property="BorderThickness" Value="0,0,1,0" />
		<Setter Property="Padding" Value="10,5,10,5" />
		<Setter Property="MinHeight" Value="30" />
		<Setter Property="Template">
			<ControlTemplate TargetType="GridViewColumnHeader">
				<Border Name="PART_HeaderBorder"
                        TransitionProperty="None"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ContentPresenter Grid.Column="0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
						<TextBlock Name="PART_SortIndicator"
                                   Grid.Column="1"
                                   Foreground="{ThemeResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Visibility="Collapsed" />
					</Grid>
				</Border>
				<ControlTemplate.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter TargetName="PART_HeaderBorder" Property="Background" Value="{ThemeResource ControlBackgroundHover}" />
					</Trigger>
					<Trigger Property="IsPressed" Value="True">
						<Setter TargetName="PART_HeaderBorder" Property="Background" Value="{ThemeResource ControlBackgroundPressed}" />
					</Trigger>
					<Trigger Property="IsKeyboardFocused" Value="True">
						<Setter TargetName="PART_HeaderBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
					</Trigger>
					<Trigger Property="IsEnabled" Value="False">
						<Setter TargetName="PART_HeaderBorder" Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
						<Setter TargetName="PART_HeaderBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
					</Trigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>
		</Setter>

		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
			</Trigger>
		</Style.Triggers>
	</Style>

</ResourceDictionary>
