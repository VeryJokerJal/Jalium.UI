<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="SwipeActionButton">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccent}" />
        <Setter Property="Content" Value="{Binding Item.Text, RelativeSource={RelativeSource Self}}" /><Setter Property="Padding" Value="8" /><Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" />
        <Setter Property="Template"><ControlTemplate TargetType="SwipeActionButton"><Border x:Name="PART_Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><MenuIconPresenter Icon="{Binding Item.IconSource, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" Width="20" Height="20" /><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Root" Property="Opacity" Value="0.85" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PART_Root" Property="Opacity" Value="0.65" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Root" Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter>
    </Style>
    <DataTemplate x:Key="SwipeControl.ActionTemplate"><SwipeActionButton Item="{Binding}" Owner="{Binding RelativeSource={RelativeSource AncestorType=SwipeControl}}" /></DataTemplate>
    <Style TargetType="SwipeControl">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextPrimary}" /><Setter Property="ClipToBounds" Value="True" /><Setter Property="Focusable" Value="True" />
        <Setter Property="ActionItemTemplate" Value="{StaticResource SwipeControl.ActionTemplate}" />
        <Setter Property="Template"><ControlTemplate TargetType="SwipeControl"><Grid ClipToBounds="True">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.5" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="SwipeStates"><VisualState x:Name="Opened" /><VisualState x:Name="Dragging" /><VisualState x:Name="Closed"><VisualState.Setters><Setter TargetName="PART_Actions" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="DirectionStates"><VisualState x:Name="None" /><VisualState x:Name="Left" /><VisualState x:Name="Right"><VisualState.Setters><Setter TargetName="PART_Actions" Property="HorizontalAlignment" Value="Right" /></VisualState.Setters></VisualState><VisualState x:Name="Top"><VisualState.Setters><Setter TargetName="PART_Actions" Property="HorizontalAlignment" Value="Stretch" /><Setter TargetName="PART_Actions" Property="VerticalAlignment" Value="Top" /></VisualState.Setters></VisualState><VisualState x:Name="Bottom"><VisualState.Setters><Setter TargetName="PART_Actions" Property="HorizontalAlignment" Value="Stretch" /><Setter TargetName="PART_Actions" Property="VerticalAlignment" Value="Bottom" /></VisualState.Setters></VisualState></VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ItemsControl x:Name="PART_Actions" ItemsSource="{TemplateBinding RevealedItems}" ItemTemplate="{TemplateBinding ActionItemTemplate}" ItemContainerStyle="{TemplateBinding ActionContainerStyle}" Width="{TemplateBinding RevealWidth}" Height="{TemplateBinding RevealHeight}" HorizontalAlignment="Left" VerticalAlignment="Stretch" IsHitTestVisible="{TemplateBinding IsOpen}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="{Binding ActionRows, RelativeSource={RelativeSource AncestorType=SwipeControl}}" Columns="{Binding ActionColumns, RelativeSource={RelativeSource AncestorType=SwipeControl}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" RenderTransform="{TemplateBinding ContentTranslation}"><ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" /></Border>
        </Grid></ControlTemplate></Setter>
    </Style>
</ResourceDictionary>
