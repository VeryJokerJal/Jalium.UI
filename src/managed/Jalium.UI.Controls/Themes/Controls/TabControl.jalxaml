<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- TabControl Style -->
    <!-- ============================================== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{ThemeResource TabContentBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TabStripBorder}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TabStripBackground" Value="{ThemeResource TabStripBackground}" />
        <Setter Property="TabStripBorderBrush" Value="{ThemeResource TabStripBorder}" />
        <Setter Property="TabStripHeight" Value="36" />
        <Setter Property="FontSize" Value="{ThemeResource CaptionFontSize}" />
        <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}" />

        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate>
            <TabPanel Background="Transparent" TabStripPlacement="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" />
        </ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate TargetType="TabControl">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="PlacementStates">
                            <VisualState x:Name="Top" />
                            <VisualState x:Name="Bottom"><VisualState.Setters>
                                <Setter TargetName="PART_HeaderDock" Property="DockPanel.Dock" Value="Bottom" />
                                <Setter TargetName="PART_HeaderSurface" Property="BorderThickness" Value="0,1,0,0" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="Left"><VisualState.Setters>
                                <Setter TargetName="PART_HeaderDock" Property="DockPanel.Dock" Value="Left" />
                                <Setter TargetName="PART_HeaderSurface" Property="BorderThickness" Value="0,0,1,0" />
                                <Setter TargetName="PART_HeaderDock" Property="MinWidth" Value="120" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="Right"><VisualState.Setters>
                                <Setter TargetName="PART_HeaderDock" Property="DockPanel.Dock" Value="Right" />
                                <Setter TargetName="PART_HeaderSurface" Property="BorderThickness" Value="1,0,0,0" />
                                <Setter TargetName="PART_HeaderDock" Property="MinWidth" Value="120" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled" /></VisualStateGroup>
                        <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" />
                            <VisualState x:Name="Focused"><VisualState.Setters>
                                <Setter TargetName="PART_Focus" Property="Visibility" Value="Visible" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                <DockPanel>

                    <Grid Name="PART_HeaderDock" DockPanel.Dock="Top" MinHeight="{TemplateBinding TabStripHeight}">
                        <Border Name="PART_HeaderSurface" Background="{TemplateBinding TabStripBackground}"
                                BorderBrush="{TemplateBinding TabStripBorderBrush}" BorderThickness="0,0,0,1">
                            <ItemsPresenter Name="PART_ItemsPresenter" />
                        </Border>
                        <Border Name="PART_Focus" BorderBrush="{ThemeResource ControlBorderFocused}" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                      HorizontalAlignment="{TemplateBinding SelectedContentHorizontalAlignment}"
                                      VerticalAlignment="{TemplateBinding SelectedContentVerticalAlignment}" />
                </DockPanel>
            </Border>
        </ControlTemplate></Setter>

        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="TabStripBorderBrush" Value="{ThemeResource ControlBorderFocused}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
                <Setter Property="TabStripBackground" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="TabStripBorderBrush" Value="{ThemeResource ControlBorderDisabled}" />
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- TabItem Style -->
    <!-- ============================================== -->
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="{ThemeResource CaptionFontSize}" />
        <Setter Property="FontFamily" Value="{ThemeResource BodyFontFamily}" />
        <Setter Property="IndicatorBrush" Value="{ThemeResource TabItemIndicator}" />
        <Setter Property="IndicatorHeight" Value="2" />
        <Setter Property="SelectedBackground" Value="{ThemeResource TabItemSelectedBackground}" />
        <Setter Property="HoverBackground" Value="{ThemeResource TabItemHoverBackground}" />

        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><ControlTemplate TargetType="TabItem">
            <Grid Background="{TemplateBinding Background}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Unselected" />
                        <VisualState x:Name="Selected"><VisualState.Setters>
                            <Setter TargetName="PART_Selection" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Indicators" Property="Visibility" Value="Visible" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" />
                        <VisualState x:Name="MouseOver"><VisualState.Setters>
                            <Setter TargetName="PART_Hover" Property="Visibility" Value="Visible" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.55" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" />
                        <VisualState x:Name="Focused"><VisualState.Setters>
                            <Setter TargetName="PART_Focus" Property="Visibility" Value="Visible" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="PlacementStates">
                        <VisualState x:Name="Top"><VisualState.Setters><Setter TargetName="PART_IndicatorBottom" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Bottom"><VisualState.Setters><Setter TargetName="PART_IndicatorTop" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Left"><VisualState.Setters><Setter TargetName="PART_IndicatorRight" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Right"><VisualState.Setters><Setter TargetName="PART_IndicatorLeft" Property="Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Name="PART_Hover" Background="{TemplateBinding HoverBackground}" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border Name="PART_Selection" Background="{TemplateBinding SelectedBackground}" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True"
                                      Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Grid Name="PART_Indicators" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border Name="PART_IndicatorBottom" Background="{TemplateBinding IndicatorBrush}" Height="{TemplateBinding IndicatorHeight}" VerticalAlignment="Bottom" Visibility="Collapsed" />
                    <Border Name="PART_IndicatorTop" Background="{TemplateBinding IndicatorBrush}" Height="{TemplateBinding IndicatorHeight}" VerticalAlignment="Top" Visibility="Collapsed" />
                    <Border Name="PART_IndicatorRight" Background="{TemplateBinding IndicatorBrush}" Width="{TemplateBinding IndicatorHeight}" HorizontalAlignment="Right" Visibility="Collapsed" />
                    <Border Name="PART_IndicatorLeft" Background="{TemplateBinding IndicatorBrush}" Width="{TemplateBinding IndicatorHeight}" HorizontalAlignment="Left" Visibility="Collapsed" />
                </Grid>
                <Border Name="PART_Focus" BorderBrush="{ThemeResource ControlBorderFocused}" BorderThickness="1" Margin="2"
                        CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
        </ControlTemplate></Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
                <Setter Property="IndicatorBrush" Value="{ThemeResource ControlBorderFocused}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="SelectedBackground" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="HoverBackground" Value="{ThemeResource ControlBackgroundDisabled}" />
                <Setter Property="IndicatorBrush" Value="{ThemeResource ControlBorderDisabled}" />
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- TabPanel Style -->
    <!-- ============================================== -->
    <Style TargetType="TabPanel">
        <Setter Property="Background" Value="{ThemeResource TabStripBackground}" />
    </Style>

</ResourceDictionary>
