<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="clr-namespace:Jalium.UI.Input;assembly=Jalium.UI.Input">

    <Style x:Key="TreeDataGridExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Content.Text, RelativeSource={RelativeSource FindAncestor, AncestorType=TreeDataGridCellPresenter}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToggleButton">
                <Border Name="PART_ExpanderSurface" Background="{TemplateBinding Background}" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_ExpanderSurface" Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="PART_ExpanderSurface" Property="Background" Value="{ThemeResource ControlBackgroundPressed}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style TargetType="TreeDataGridCellPresenter">
        <Setter Property="ExpanderStyle" Value="{StaticResource TreeDataGridExpanderStyle}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TreeDataGridCellPresenter">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled"><VisualState.Setters>
                                <Setter Property="Opacity" Value="0.56" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="NodeStates">
                            <VisualState x:Name="Branch" />
                            <VisualState x:Name="Leaf"><VisualState.Setters>
                                <Setter TargetName="PART_Expander" Property="Visibility" Value="Hidden" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="ExpansionStates">
                            <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.16" /></VisualStateGroup.Transitions>
                            <VisualState x:Name="Collapsed" />
                            <VisualState x:Name="Expanded"><VisualState.Setters>
                                <Setter TargetName="PART_CollapsedGlyph" Property="Opacity" Value="0" />
                                <Setter TargetName="PART_ExpandedGlyph" Property="Opacity" Value="1" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Name="PART_IndentSpacer" Width="{TemplateBinding IndentWidth}" />
                        <ToggleButton Name="PART_Expander" Grid.Column="1" Width="{TemplateBinding ExpanderSize}"
                                      Height="{TemplateBinding ExpanderSize}" Style="{TemplateBinding ExpanderStyle}">
                            <Grid Width="8" Height="8">
                                <Path Name="PART_CollapsedGlyph" Data="M 0,0 L 6,4 L 0,8" Width="6" Height="8"
                                      Stroke="{ThemeResource TextSecondary}" StrokeThickness="1.5" Stretch="Uniform" />
                                <Path Name="PART_ExpandedGlyph" Data="M 0,0 L 4,6 L 8,0" Width="8" Height="6"
                                      VerticalAlignment="Center" Stroke="{ThemeResource TextSecondary}" StrokeThickness="1.5"
                                      Stretch="Uniform" Opacity="0" />
                            </Grid>
                        </ToggleButton>
                        <ContentPresenter Name="PART_ContentPresenter" Grid.Column="2"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- TreeDataGrid Style -->
    <!-- ============================================== -->
    <Style TargetType="TreeDataGrid">
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="HorizontalGridLinesBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="VerticalGridLinesBrush" Value="{ThemeResource ControlBorder}" />
        <Setter Property="AlternatingRowBackground" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TreeDataGrid">
                <Border Name="PART_OuterBorder" input:KeyboardNavigation.TabNavigation="None"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12"
                        Shape="RoundedRectangle"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Column headers area -->
                        <Grid Name="PART_ColumnHeadersBorder"
                              Grid.Row="0"
                              Background="{ThemeResource LayerFillColorAltBrush}">
                            <ScrollViewer Name="PART_ColumnHeadersScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <StackPanel Name="PART_ColumnHeadersHost" Orientation="Horizontal" />
                            </ScrollViewer>
                            <Rectangle Height="1"
                                       VerticalAlignment="Bottom"
                                       Fill="{ThemeResource ControlBorder}"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <!-- Data rows area -->
                        <ScrollViewer Name="PART_DataScrollViewer"
                                      Grid.Row="1"
                                      Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <StackPanel Name="PART_RowsHost">
                                <Grid Name="PART_TopSpacer" Height="0" IsHitTestVisible="False" />
                                <Grid Name="PART_BottomSpacer" Height="0" IsHitTestVisible="False" />
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Drag overlay for column reorder -->
                        <Canvas Name="PART_DragOverlay"
                                Grid.RowSpan="2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" >
                            <DataGridDropLocationIndicator Name="PART_DropIndicator" Visibility="Collapsed" />
                            <DataGridColumnDragIndicator Name="PART_DragGhost" />
                        </Canvas>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="PART_OuterBorder" Property="BorderBrush" Value="{ThemeResource ControlBorderFocused}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{ThemeResource TextDisabled}" />
                <Setter Property="Opacity" Value="0.56" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- TreeDataGridRow Style -->
    <!-- ============================================== -->
    <Style TargetType="TreeDataGridRow">
        <Setter Property="GridLinesVisibility" Value="{Binding ParentTreeDataGrid.GridLinesVisibility, RelativeSource={RelativeSource Self}}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{Binding ParentTreeDataGrid.HorizontalGridLinesBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="VerticalGridLinesBrush" Value="{Binding ParentTreeDataGrid.VerticalGridLinesBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{Binding ParentTreeDataGrid.FontFamily, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontSize" Value="{Binding ParentTreeDataGrid.FontSize, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontStyle" Value="{Binding ParentTreeDataGrid.FontStyle, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontWeight" Value="{Binding ParentTreeDataGrid.FontWeight, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{Binding OwnerBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{Binding ParentTreeDataGrid.Foreground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TreeDataGridRow">
                <Border Name="PART_RowBorder" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding HorizontalGridLinesBrush}" BorderThickness="0">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="GridLineStates">
                            <VisualState x:Name="GridLinesNone" />
                            <VisualState x:Name="GridLinesHorizontal"><VisualState.Setters>
                                <Setter TargetName="PART_RowBorder" Property="BorderThickness" Value="0,0,0,1" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>

                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver"><VisualState.Setters>
                                <Setter TargetName="PART_HoverTint" Property="Visibility" Value="Visible" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters>
                                <Setter Property="Opacity" Value="0.56" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="SelectionStates">
                            <VisualState x:Name="Unselected" />
                            <VisualState x:Name="Selected"><VisualState.Setters>
                                <Setter TargetName="PART_SelectionTint" Property="Visibility" Value="Visible" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid>
                        <Grid Name="PART_HoverTint" Background="{ThemeResource TextPrimary}" Opacity="0.04"
                              IsHitTestVisible="False" Visibility="Collapsed" />
                        <Grid Name="PART_SelectionTint" Background="{ThemeResource AccentBrush}" Opacity="0.12"
                              IsHitTestVisible="False" Visibility="Collapsed" />
                        <StackPanel Name="PART_CellsPanel" Orientation="Horizontal" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ParentTreeDataGrid" Value="{x:Null}">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
