if(NOT DEFINED HOST_APP OR NOT IS_DIRECTORY "${HOST_APP}")
    message(FATAL_ERROR "A Window validation application is required")
endif()
if(NOT DEFINED HOST_WORK_DIR)
    if("$ENV{HOME}" STREQUAL "")
        message(FATAL_ERROR "A Window validation work directory or HOME is required")
    endif()
    # The application must not need removable-volume consent just to log startup.
    set(HOST_WORK_DIR "$ENV{HOME}/Library/Caches/Jalium.UI/WindowValidation")
endif()
if(NOT DEFINED HOST_LAUNCHER)
    set(HOST_LAUNCHER /usr/bin/open)
endif()
string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef nonce)
set(directory "${HOST_WORK_DIR}/${nonce}")
file(MAKE_DIRECTORY "${directory}")
file(CHMOD "${directory}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)

function(cleanup_owned_window_validation)
    # LaunchServices children are not necessarily killed with the timed-out open
    # process. Match the entire executable/argument string, including this nonce,
    # and recheck immediately before each signal to avoid stale PID cleanup.
    get_filename_component(application_name "${HOST_APP}" NAME_WLE)
    set(host_command "${HOST_APP}/Contents/MacOS/${application_name} --window-validation-directory ${directory} --window-validation-nonce ${nonce}")
    set(launcher_command "${HOST_LAUNCHER} -n -W ${HOST_APP} --args --window-validation-directory ${directory} --window-validation-nonce ${nonce}")
    execute_process(COMMAND /bin/ps -ax -o pid= -o command=
        OUTPUT_VARIABLE processes RESULT_VARIABLE ps_result)
    if(NOT ps_result EQUAL 0)
        message(WARNING "Could not inspect Window validation processes for cleanup")
        return()
    endif()
    string(REPLACE "\n" ";" process_lines "${processes}")
    set(owned_pids "")
    foreach(line IN LISTS process_lines)
        if(line MATCHES "^[ \t]*([1-9][0-9]*)[ \t]+(.*)$")
            set(candidate_pid "${CMAKE_MATCH_1}")
            set(candidate_command "${CMAKE_MATCH_2}")
            if(candidate_pid GREATER 1 AND
                (candidate_command STREQUAL host_command OR candidate_command STREQUAL launcher_command))
                list(APPEND owned_pids "${candidate_pid}")
            endif()
        endif()
    endforeach()
    foreach(signal TERM KILL)
        foreach(pid IN LISTS owned_pids)
            execute_process(COMMAND /bin/ps -p "${pid}" -o command=
                OUTPUT_VARIABLE command RESULT_VARIABLE inspect_result OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(inspect_result EQUAL 0 AND (command STREQUAL host_command OR command STREQUAL launcher_command))
                execute_process(COMMAND /bin/kill "-${signal}" "${pid}" RESULT_VARIABLE kill_result)
                file(APPEND "${directory}/cleanup.log" "signal=${signal} pid=${pid} result=${kill_result}\n")
            endif()
        endforeach()
        if(signal STREQUAL "TERM" AND owned_pids)
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
        endif()
    endforeach()
endfunction()

execute_process(
    COMMAND "${HOST_LAUNCHER}" -n -W "${HOST_APP}" --args
        --window-validation-directory "${directory}" --window-validation-nonce "${nonce}"
    RESULT_VARIABLE launch_result
    OUTPUT_VARIABLE launch_output ERROR_VARIABLE launch_error TIMEOUT 58)
if(EXISTS "${directory}/host.log")
    file(READ "${directory}/host.log" log)
    message("${log}")
endif()
set(failure "")
if(NOT "${launch_result}" STREQUAL "0")
    set(failure "Window application launch/wait failed: ${launch_result}\n${launch_output}${launch_error}")
elseif(NOT EXISTS "${directory}/result.json")
    set(failure "Window application exited without its completion record")
else()
    file(READ "${directory}/result.json" record)
    foreach(field schema nonce pid result)
        string(JSON "${field}_type" ERROR_VARIABLE json_error TYPE "${record}" "${field}")
        if(NOT json_error STREQUAL "NOTFOUND")
            set(failure "Invalid Window completion record: ${field}")
            break()
        endif()
        string(JSON "${field}_value" GET "${record}" "${field}")
    endforeach()
    if(NOT failure)
        if(NOT schema_type STREQUAL "NUMBER" OR NOT schema_value STREQUAL "1" OR
            NOT nonce_type STREQUAL "STRING" OR NOT "${nonce_value}" STREQUAL "${nonce}" OR
            NOT pid_type STREQUAL "NUMBER" OR NOT pid_value MATCHES "^[1-9][0-9]*$" OR
            NOT result_type STREQUAL "NUMBER" OR NOT result_value STREQUAL "0")
            set(failure "Window completion record does not confirm this successful run")
        endif()
    endif()
endif()
if(NOT failure)
    foreach(stage STARTED FINISHED EXIT)
        set(marker "HOST_${stage} pid=${pid_value}")
        if(NOT stage STREQUAL "STARTED")
            string(APPEND marker " result=0\n")
        else()
            string(APPEND marker " bundle=")
        endif()
        string(FIND "${log}" "${marker}" marker_position)
        if(marker_position LESS 0)
            set(failure "Window log does not confirm the original process stage: ${stage}")
            break()
        endif()
    endforeach()
    if(log MATCHES "(^|\n)FAIL:")
        set(failure "Window application reported a failure")
    endif()
endif()
if(failure)
    cleanup_owned_window_validation()
    file(WRITE "${directory}/failure.txt" "${failure}\n${launch_output}${launch_error}")
    message(FATAL_ERROR "${failure}\nWindow validation diagnostics retained: ${directory}")
endif()
file(REMOVE_RECURSE "${directory}")
message(STATUS "Window application contracts passed; pid=${pid_value}")
