<Project>
  <!-- Runtime copying stays RID-specific. Packing can include both complete
       outputs without copying the opposing CPU into a project's app bundle. -->
  <Target Name="CollectMacOSNativePackageAssets" BeforeTargets="_GetPackageFiles;GenerateNuspec"
          DependsOnTargets="ValidateMacOSNativeExports"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_JaliumMacEffectivePackRid>$(JaliumMacNativePackRid)</_JaliumMacEffectivePackRid>
      <_JaliumMacEffectivePackRid Condition="'$(_JaliumMacEffectivePackRid)' == '' and '$(_JaliumMacNativeRootWasExplicit)' == 'true'">$(RuntimeIdentifier)</_JaliumMacEffectivePackRid>
      <_JaliumMacPackArmRoot>$(JaliumMacNativeOutputRoot)/osx-arm64/$(Configuration)</_JaliumMacPackArmRoot>
      <_JaliumMacPackX64Root>$(JaliumMacNativeOutputRoot)/osx-x64/$(Configuration)</_JaliumMacPackX64Root>
      <_JaliumMacPackArmRoot Condition="'$(_JaliumMacNativeRootWasExplicit)' == 'true' and '$(RuntimeIdentifier)' == 'osx-arm64'">$(JaliumMacNativeRoot)</_JaliumMacPackArmRoot>
      <_JaliumMacPackX64Root Condition="'$(_JaliumMacNativeRootWasExplicit)' == 'true' and '$(RuntimeIdentifier)' == 'osx-x64'">$(JaliumMacNativeRoot)</_JaliumMacPackX64Root>
      <_JaliumMacPackArm Condition="'$(_JaliumMacEffectivePackRid)' == '' or '$(_JaliumMacEffectivePackRid)' == 'osx-arm64'">true</_JaliumMacPackArm>
      <_JaliumMacPackX64 Condition="'$(_JaliumMacEffectivePackRid)' == '' or '$(_JaliumMacEffectivePackRid)' == 'osx-x64'">true</_JaliumMacPackX64>
    </PropertyGroup>
    <Error Condition="'$(JaliumMacNativePackRid)' != '' and '$(JaliumMacNativePackRid)' != 'osx-arm64' and '$(JaliumMacNativePackRid)' != 'osx-x64'"
           Text="Unsupported JaliumMacNativePackRid '$(JaliumMacNativePackRid)'. Use osx-arm64 or osx-x64." />
    <Error Condition="'$(_JaliumMacNativeRootWasExplicit)' == 'true' and '$(_JaliumMacEffectivePackRid)' != '$(RuntimeIdentifier)'"
           Text="An explicit JaliumMacNativeRoot packages the current RuntimeIdentifier. Use JaliumMacNativeOutputRoot for multiple RID outputs." />
    <Error Condition="'$(JaliumMacRequireAllNativeRids)' == 'true' and '$(_JaliumMacEffectivePackRid)' != ''"
           Text="Requiring both macOS RIDs cannot be combined with a single RID or explicit JaliumMacNativeRoot. Set JaliumMacNativeOutputRoot to the directory containing both outputs." />
    <Error Condition="'$(_JaliumMacPackArm)' == 'true' and !Exists('$(_JaliumMacPackArmRoot)/.jalium-native-complete') and ('$(JaliumMacRequireAllNativeRids)' == 'true' or '$(_JaliumMacEffectivePackRid)' != '' or Exists('$(_JaliumMacPackArmRoot)'))"
           Text="A complete osx-arm64 payload is required at '$(_JaliumMacPackArmRoot)'. Finish the build or explicitly select a different JaliumMacNativePackRid." />
    <Error Condition="'$(_JaliumMacPackX64)' == 'true' and !Exists('$(_JaliumMacPackX64Root)/.jalium-native-complete') and ('$(JaliumMacRequireAllNativeRids)' == 'true' or '$(_JaliumMacEffectivePackRid)' != '' or Exists('$(_JaliumMacPackX64Root)'))"
           Text="A complete osx-x64 payload is required at '$(_JaliumMacPackX64Root)'. Finish the build or explicitly select a different JaliumMacNativePackRid." />
    <PropertyGroup>
      <_JaliumMacPackArmReady Condition="'$(_JaliumMacPackArm)' == 'true' and Exists('$(_JaliumMacPackArmRoot)/.jalium-native-complete')">true</_JaliumMacPackArmReady>
      <_JaliumMacPackX64Ready Condition="'$(_JaliumMacPackX64)' == 'true' and Exists('$(_JaliumMacPackX64Root)/.jalium-native-complete')">true</_JaliumMacPackX64Ready>
    </PropertyGroup>
    <Error Condition="'$(_JaliumMacPackArmReady)' != 'true' and '$(_JaliumMacPackX64Ready)' != 'true'"
           Text="No complete macOS native output is available for packing at '$(JaliumMacNativeOutputRoot)'." />
    <Exec Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(_JaliumMacPackArmReady)' == 'true'"
          Command="/usr/bin/python3 &quot;$(MSBuildThisFileDirectory)../../../eng/apple/macos-native-artifact.py&quot; validate --payload &quot;$(_JaliumMacPackArmRoot)&quot; --configuration &quot;$(Configuration)&quot; --runtime-identifier osx-arm64" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(_JaliumMacPackX64Ready)' == 'true'"
          Command="/usr/bin/python3 &quot;$(MSBuildThisFileDirectory)../../../eng/apple/macos-native-artifact.py&quot; validate --payload &quot;$(_JaliumMacPackX64Root)&quot; --configuration &quot;$(Configuration)&quot; --runtime-identifier osx-x64" />
    <ItemGroup>
      <_JaliumMacPackAssets Include="$(_JaliumMacPackArmRoot)/*.dylib;$(_JaliumMacPackArmRoot)/*.metallib;$(_JaliumMacPackArmRoot)/jalium_metal_manifest.json"
            Condition="'$(_JaliumMacPackArmReady)' == 'true'" Pack="true" PackagePath="runtimes/osx-arm64/native"
            CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Visible="false" />
      <_JaliumMacPackAssets Include="$(_JaliumMacPackX64Root)/*.dylib;$(_JaliumMacPackX64Root)/*.metallib;$(_JaliumMacPackX64Root)/jalium_metal_manifest.json"
            Condition="'$(_JaliumMacPackX64Ready)' == 'true'" Pack="true" PackagePath="runtimes/osx-x64/native"
            CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Visible="false" />
      <None Include="@(_JaliumMacPackAssets)" />
    </ItemGroup>
  </Target>
  <!-- NuGet also excludes Content with Pack=false by source path. Clear only
       the selected pack assets from that exclusion, keeping runtime copying
       and unrelated Content exclusions intact. -->
  <Target Name="IncludeSelectedMacOSNativePackageAssets" AfterTargets="_GetPackageFiles"
          DependsOnTargets="CollectMacOSNativePackageAssets">
    <ItemGroup>
      <_PackageFilesToExclude Remove="@(_JaliumMacPackAssets)" />
    </ItemGroup>
  </Target>
</Project>
