<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- These tests exercise managed contracts without opening AppKit windows.
         The native Window suite owns main-thread AppKit integration checks. -->
    <AssemblyName>Jalium.UI.Tests</AssemblyName>
    <RootNamespace>Jalium.UI.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(JaliumMacNativeGeometryTests)' == 'true'">$(DefineConstants);JALIUM_MAC_NATIVE_GEOMETRY_TESTS</DefineConstants>
    <JaliumMacNativeRoot Condition="'$(JaliumMacNativeRoot)' == ''">$(MSBuildThisFileDirectory)../../src/native/bin/native/osx-arm64/$(Configuration)</JaliumMacNativeRoot>
  </PropertyGroup>
  <!-- The managed editor contracts also depend on the native text ABI. Copy
       the validated current payload rather than reusing dylibs left by an
       earlier test run (which can silently lack line/range metrics). -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="$(JaliumMacNativeRoot)/*.dylib" Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="Always" />
  </ItemGroup>
