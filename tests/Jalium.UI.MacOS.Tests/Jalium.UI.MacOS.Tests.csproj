<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- These tests exercise managed contracts without opening AppKit windows.
         The native Window suite owns main-thread AppKit integration checks. -->
    <AssemblyName>Jalium.UI.Tests</AssemblyName>
    <RootNamespace>Jalium.UI.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(JaliumMacNativeGeometryTests)' == 'true'">$(DefineConstants);JALIUM_MAC_NATIVE_GEOMETRY_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/packaging/Jalium.UI.MacOS/FileDialogFilterSelection.cs" Link="FileDialogFilterSelection.cs" />
    <Compile Include="../Jalium.UI.Tests/TextBlockNoWrapInheritanceTests.cs" Link="TextBlockNoWrapInheritanceTests.cs" />
    <Compile Include="../Jalium.UI.Tests/TextBlockParityTests.cs" Link="TextBlockParityTests.cs" />
    <Compile Include="../Jalium.UI.Tests/TextBlockRenderCacheTests.cs" Link="TextBlockRenderCacheTests.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Using Include="Xunit" />
    <Using Include="Jalium.UI.Threading" />
    <Using Include="Jalium.UI.Automation.Peers" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="MacOSTextGeometryIntegrationTests.cs" />
    <Compile Include="MacOSTextGeometryIntegrationTests.cs" Condition="'$(JaliumMacNativeGeometryTests)' == 'true'" />
    <Compile Remove="MacOSWindowVisualLineTests.cs" />
    <Compile Include="MacOSWindowVisualLineTests.cs" Condition="'$(JaliumMacNativeGeometryTests)' == 'true'" />
    <Compile Remove="MacOSRichParagraphTests.cs" />
