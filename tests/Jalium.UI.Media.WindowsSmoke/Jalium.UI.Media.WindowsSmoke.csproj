<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(JaliumRuntimeRoot)' != ''">
    <Reference Include="Jalium.UI.Managed" HintPath="$(JaliumRuntimeRoot)/Jalium.UI.Managed.dll" />
    <Content Include="$(JaliumRuntimeRoot)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(JaliumRuntimeRoot)' == ''">
    <ProjectReference Include="../../src/managed/Jalium.UI.Controls/Jalium.UI.Controls.csproj" />
  </ItemGroup>
</Project>
