<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Jalium.UI.Tests.GeneratedResourceKeysView">
    <UserControl.Resources>
        <Style x:Key="{x:Static DataGridTextColumn.DefaultElementStyleKey}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="31" />
        </Style>
        <Style x:Key="{x:Type TextBox}" TargetType="TextBox"><Setter Property="FontSize" Value="23" /></Style>
        <Style x:Key="{}{literal}" TargetType="TextBlock"><Setter Property="FontSize" Value="17" /></Style>
    </UserControl.Resources>
    <Border Name="Scope">
        <Border.Resources>
            <Style x:Key="{x:Static DataGridCheckBoxColumn.DefaultElementStyleKey}" TargetType="CheckBox">
                <Setter Property="IsEnabled" Value="False" />
            </Style>
        </Border.Resources>
        <TextBlock Name="Sample" Text="Keyed" Style="{StaticResource {x:Static DataGridTextColumn.DefaultElementStyleKey}}" />
    </Border>
</UserControl>
