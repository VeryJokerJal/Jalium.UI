<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Jalium.UI.Tests.GeneratedWindowThemeView" ThemeMode="Light">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ThemeProbeBrush" Color="#FFF5F5F7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ThemeProbeBrush" Color="#FF1C1C1E" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel>
        <Border x:Name="StaticSample" Background="{StaticResource ThemeProbeBrush}" />
        <Border x:Name="DynamicSample" Background="{ThemeResource ThemeProbeBrush}" />
    </StackPanel>
</Window>
