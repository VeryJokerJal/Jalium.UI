<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jalium.UI.HotReload.Watcher</RootNamespace>
    <AssemblyName>Jalium.UI.HotReload.Watcher</AssemblyName>
    <!-- Development-time tool; never trimmed/AOT'd or shipped with an app. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source-link the shared HotReloadProtocol (frame encoding) instead of referencing
         Jalium.UI.Xaml: one copy, linked twice, so client / server / test stay in lock-step —
         while the watcher process never loads a framework assembly. Referencing the assembly
         runs the framework's [ModuleInitializer] chain (ThemeLoader → Jalium.UI.Managed
         <Module>.cctor → PackWebRequestRegistration) on first touch, which needs runtime
         dependencies (System.IO.Packaging) this tool does not deploy. -->
    <Compile Include="..\..\src\managed\Jalium.UI.Xaml\HotReloadProtocol.cs"
             Link="HotReloadProtocol.cs" />
  </ItemGroup>

</Project>
